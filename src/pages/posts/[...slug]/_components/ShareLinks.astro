---
import LinkButton from "@/components/LinkButton.astro";
import { tplStr, useTranslations } from "@/i18n";
import config from "@/config";
import IconLink from "@/assets/icons/IconLink.svg";

const { shareLinks } = config;
const t = useTranslations(Astro.currentLocale);

const icons = import.meta.glob<{
  default: (_props: Record<string, unknown>) => unknown;
}>("/src/assets/icons/socials/*.svg");

const pageUrl = Astro.url;
// 复制按钮复制的是线上网址，本地预览时也一样
const liveUrl = new URL(Astro.url.pathname, config.site.url).href;

const platformLabel = (name: string) =>
  name.charAt(0).toUpperCase() + name.slice(1);

const items = await Promise.all(
  shareLinks.map(async ({ name, url, linkTitle }) => {
    const mod = await icons[`/src/assets/icons/socials/${name}.svg`]?.();
    const Icon = mod?.default;
    const title =
      linkTitle ??
      (name === "mail"
        ? t.post.sharePostViaEmail
        : tplStr(t.post.sharePostOn, { platform: platformLabel(name) }));
    return { url, title, Icon };
  })
);
---

{
  items.some(({ Icon }) => Icon) && (
    <div class="flex flex-none flex-col items-center justify-center gap-1 md:items-start">
      <span>{t.post.sharePostIntro}</span>
      <div class="text-center">
        {items.map(({ url, title, Icon }) =>
          Icon ? (
            <LinkButton
              href={`${url}${pageUrl}`}
              class="scale-90 p-2 hover:rotate-6 sm:p-1"
              title={title}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon class="inline-block size-6 scale-125 fill-transparent stroke-current stroke-2 opacity-90 group-hover:fill-transparent sm:scale-110" />
              <span class="sr-only">{title}</span>
            </LinkButton>
          ) : null
        )}
        <button
          type="button"
          class="share-copy group inline-flex scale-90 items-center gap-1 p-2 hover:rotate-6 hover:text-accent sm:p-1"
          title={t.post.copyLink}
          data-url={liveUrl}
          data-copied={t.post.copied}
        >
          <IconLink class="inline-block size-6 scale-125 fill-transparent stroke-current stroke-2 opacity-90 sm:scale-110" />
          <span class="sr-only">{t.post.copyLink}</span>
        </button>
        <span class="share-copy-msg text-sm" aria-live="polite"></span>
      </div>
    </div>
  )
}

<script>
  // 点链接图标：把线上网址复制到剪贴板，旁边短暂显示"已复制"
  document.addEventListener("click", async e => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(".share-copy");
    if (!btn) return;
    const url = btn.dataset.url!;
    try {
      await navigator.clipboard.writeText(url);
    } catch {
      // 剪贴板接口不可用时（旧浏览器、内嵌网页视图），退回到选中文本再复制
      const ta = document.createElement("textarea");
      ta.value = url;
      ta.setAttribute("readonly", "");
      ta.style.position = "fixed";
      ta.style.opacity = "0";
      document.body.append(ta);
      ta.select();
      const ok = document.execCommand("copy");
      ta.remove();
      if (!ok) return;
    }
    const msg = btn.parentElement!.querySelector<HTMLElement>(".share-copy-msg")!;
    msg.textContent = btn.dataset.copied!;
    setTimeout(() => (msg.textContent = ""), 1500);
  });
</script>
