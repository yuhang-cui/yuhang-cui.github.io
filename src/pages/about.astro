---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const about = await getEntry("pages", "about");

if (!about) {
  throw new Error(
    "Missing content entry: `about.md` or `about.mdx` in `src/content/pages/`"
  );
}

const { Content } = await render(about);
---

<Layout
  title={`${about.data.title} | ${config.site.title}`}
  description={about.data.description}
  ogImage={about.data.ogImage}
  canonicalURL={about.data.canonicalURL}
>
  <Header />

  <main id="main-content" class="app-layout pt-10 pb-4 sm:pt-16">
    <p class="text-muted-foreground text-lg">Hi，</p>
    <h1 class="mt-1 text-4xl font-bold sm:text-5xl">我是兰森</h1>
    <div class="app-prose mt-8">
      <Content />
    </div>
  </main>

  <Footer />
</Layout>
