---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { useTranslations } from "@/i18n";

const locale = Astro.currentLocale;
const t = useTranslations(locale);
// 英文版的关于页是 src/content/pages/about-en.md
const about = await getEntry("pages", locale === "en" ? "about-en" : "about");

if (!about) {
  throw new Error(
    "Missing content entry: `about.md` or `about.mdx` in `src/content/pages/`"
  );
}

const { Content } = await render(about);
---

<Layout
  title={`${about.data.title} | ${t.site.title}`}
  description={about.data.description}
  ogImage={about.data.ogImage}
  canonicalURL={about.data.canonicalURL}
>
  <Header />

  <main id="main-content" class="app-layout pt-10 pb-4 sm:pt-16">
    <p class="text-muted-foreground text-lg">{t.aboutCard.hi}</p>
    <h1 class="mt-1 text-4xl font-bold sm:text-5xl">{t.aboutCard.name}</h1>
    <div class="app-prose mt-8">
      <Content />
    </div>
  </main>

  <Footer />
</Layout>
