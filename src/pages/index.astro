---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import AboutCard from "@/components/AboutCard.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="pt-10 pb-4 sm:pt-14">
      <p class="post-meta">PA Research · ES 1-min · 2010–2026</p>
      <h1 class="text-foreground mt-3 text-3xl leading-tight font-semibold sm:text-[40px]">
        用数据检验 Price Action 的常见说法
      </h1>
      <p class="mt-5 text-[16.5px] leading-[1.85]" style="color: var(--summary)">
        这里是兰森的交易研究笔记（示例文字）。我做 ES 期货日内交易，用 16 年的 1 分钟数据检验 Price Action 里的常见说法：哪些成立，哪些只是传说。每篇研究都写清楚数据、规则和局限，方便你自己复现。
      </p>
    </section>

    {
      featuredPosts.length > 0 && (
        <section id="featured" class="pt-12">
          <h2 class="section-label">{t.home.featured}</h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-10">
          <h2 class="section-label">{t.home.recentPosts}</h2>
          <ul>
            {recentPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <!-- 窄屏时个人介绍放在文章列表之后，不再把文章挤到第二屏 -->
    <AboutCard variant="inline" />
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
