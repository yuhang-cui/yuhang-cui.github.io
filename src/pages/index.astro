---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import AboutCard from "@/components/AboutCard.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostsByLocale } from "@/utils/localePosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getPostsByLocale(locale);
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
// “最新”列出全部文章，精选的文章也在里面
const recentPosts = sortedPosts;
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <!-- 页面不显示大标题，但保留一个隐藏的标题，供搜索引擎和读屏软件识别 -->
    <h1 class="sr-only">{t.site.title}</h1>

    {
      featuredPosts.length > 0 && (
        <section id="featured" class="pt-10">
          <h2 class="section-label">{t.home.featured}</h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} noTransition />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-10">
          <h2 class="section-label">{t.home.recentPosts}</h2>
          <ul>
            {recentPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <!-- 窄屏时个人介绍放在文章列表之后，不再把文章挤到第二屏 -->
    <AboutCard variant="inline" />
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
