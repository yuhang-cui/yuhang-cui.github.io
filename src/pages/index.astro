---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import AboutCard from "@/components/AboutCard.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostsByLocale } from "@/utils/localePosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getPostsByLocale(locale);
const sortedPosts = getSortedPosts(posts);
const featured = sortedPosts.filter(({ data }) => data.featured);
// 精选默认只摊开最新的 3 篇，标题旁的箭头展开其余；featuredFolded 的排在最后，默认折叠
const featuredPosts = [
  ...featured.filter(({ data }) => !data.featuredFolded),
  ...featured.filter(({ data }) => data.featuredFolded),
];
// “最新”列出全部文章，精选的文章也在里面
const recentPosts = sortedPosts;
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <!-- 页面不显示大标题，但保留一个隐藏的标题，供搜索引擎和读屏软件识别 -->
    <h1 class="sr-only">{t.site.title}</h1>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class="pt-10"
          data-collapsed={featuredPosts.length > 3 ? "" : undefined}
        >
          <h2 class="section-title">
            {t.home.featured}<span class="section-count">{featuredPosts.length}</span>
            {featuredPosts.length > 3 && (
              <button
                type="button"
                class="featured-toggle"
                aria-expanded="false"
                aria-controls="featured-list"
                aria-label={t.home.featuredExpand}
                data-expand={t.home.featuredExpand}
                data-collapse={t.home.featuredCollapse}
              >
                <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                  <path d="M3.5 6l4.5 4.5L12.5 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
            )}
          </h2>
          <ul id="featured-list" class="post-cards">
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} noTransition boxed />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-16 pb-10">
          <h2 class="section-title">
            {t.home.recentPosts}<span class="section-count">{recentPosts.length}</span>
          </h2>
          <ul>
            {recentPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <!-- 窄屏时个人介绍放在文章列表之后，不再把文章挤到第二屏 -->
    <AboutCard variant="inline" />
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const toggle = document.querySelector<HTMLButtonElement>(".featured-toggle");
    const featured = document.querySelector<HTMLElement>("#featured");
    if (toggle && featured) {
      toggle.addEventListener("click", () => {
        const open = featured.toggleAttribute("data-collapsed") === false;
        toggle.setAttribute("aria-expanded", String(open));
        toggle.setAttribute(
          "aria-label",
          (open ? toggle.dataset.collapse : toggle.dataset.expand) ?? ""
        );
      });
    }
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
