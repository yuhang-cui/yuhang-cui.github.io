---
// 站内搜索：读构建时生成的索引（/search-index.json，英文 /en/search-index.json），
// 按原文字面匹配，中文不需要分词。多个词用空格分开，每个词都要出现。
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
// getRelativeLocaleUrl 会在末尾加 “/”，文件地址要去掉
const indexUrl = getRelativeLocaleUrl(locale, "search-index.json").replace(/\/$/, "");
---

<Layout title={`${t.pages.searchTitle} | ${t.site.title}`}>
  <Header />

  <Main pageTitle={t.pages.searchTitle}>
    <div
      id="site-search"
      data-index={indexUrl}
      data-count={t.searchUi.count}
      data-count-one={t.searchUi.countOne}
      data-none={t.searchUi.none}
    >
      <form class="search-page-form" role="search" action="" method="get">
        <input
          id="site-search-input"
          class="search-box search-box--page"
          type="search"
          name="q"
          placeholder={t.searchUi.placeholder}
          aria-label={t.searchUi.label}
          autocomplete="off"
        />
      </form>
      <p class="search-status" aria-live="polite">{t.searchUi.hint}</p>
      <ul class="search-results"></ul>
    </div>
  </Main>

  <Footer />
</Layout>

<script>
  type Doc = {
    title: string;
    url: string;
    date: string;
    category: string;
    categoryClass: string;
    description: string;
    headings: string;
    text: string;
  };

  const cache: Record<string, Promise<Doc[]>> = {};
  const loadIndex = (url: string) =>
    (cache[url] ??= fetch(url).then(r => r.json() as Promise<Doc[]>));

  const esc = (s: string) =>
    s.replace(/[&<>"]/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);

  // 把文本里出现的每个词用荧光笔线标出来
  function mark(text: string, terms: string[]) {
    let html = esc(text);
    for (const term of terms) {
      const re = new RegExp(esc(term).replace(/[.*+?^${}()|[\]\\]/g, "\\$&"), "gi");
      html = html.replace(re, m => `<mark class="search-hit">${m}</mark>`);
    }
    return html;
  }

  // 正文里第一个命中的位置前后各取一段，作为片段
  function snippet(text: string, terms: string[]) {
    const lower = text.toLowerCase();
    let at = -1;
    for (const term of terms) {
      const i = lower.indexOf(term);
      if (i >= 0 && (at < 0 || i < at)) at = i;
    }
    if (at < 0) return "";
    const start = Math.max(0, at - 50);
    const end = Math.min(text.length, at + 110);
    return (start > 0 ? "…" : "") + text.slice(start, end) + (end < text.length ? "…" : "");
  }

  function score(doc: Doc, terms: string[]) {
    const fields = [
      [doc.title.toLowerCase(), 10],
      [doc.headings.toLowerCase(), 5],
      [doc.description.toLowerCase(), 3],
      [doc.text.toLowerCase(), 1],
    ] as const;
    let total = 0;
    for (const term of terms) {
      let hit = 0;
      for (const [field, weight] of fields) {
        const n = field.split(term).length - 1;
        hit += Math.min(n, 5) * weight;
      }
      if (hit === 0) return 0; // 每个词都要出现
      total += hit;
    }
    return total;
  }

  async function run(root: HTMLElement, query: string) {
    const status = root.querySelector<HTMLElement>(".search-status")!;
    const list = root.querySelector<HTMLElement>(".search-results")!;
    const terms = query.toLowerCase().split(/\s+/).filter(Boolean);
    if (!terms.length) {
      list.innerHTML = "";
      status.textContent = status.dataset.hint ?? status.textContent;
      return;
    }
    const docs = await loadIndex(root.dataset.index!);
    const hits = docs
      .map(doc => ({ doc, s: score(doc, terms) }))
      .filter(h => h.s > 0)
      .sort((a, b) => b.s - a.s);

    status.textContent = hits.length
      ? hits.length === 1
        ? root.dataset.countOne!
        : root.dataset.count!.replace("{{n}}", String(hits.length))
      : root.dataset.none!.replace("{{q}}", query.trim());

    list.innerHTML = hits
      .map(({ doc }) => {
        const snip = snippet(doc.text, terms) || doc.description;
        return `<li class="search-result">
          <a href="${doc.url}">
            <p class="search-result-title">${mark(doc.title, terms)}</p>
            <p class="post-meta">${doc.category ? `<span class="tag-pill ${doc.categoryClass}">${esc(doc.category)}</span>` : ""}<time>${doc.date}</time></p>
            <p class="search-result-snippet">${mark(snip, terms)}</p>
          </a>
        </li>`;
      })
      .join("");
  }

  function setup() {
    const root = document.getElementById("site-search");
    if (!root || root.dataset.ready) return;
    root.dataset.ready = "1";
    const input = root.querySelector<HTMLInputElement>("#site-search-input")!;
    const status = root.querySelector<HTMLElement>(".search-status")!;
    status.dataset.hint = status.textContent ?? "";

    const params = new URLSearchParams(location.search);
    input.value = params.get("q") ?? "";

    let timer: number | undefined;
    const update = () => {
      const q = input.value;
      const url = new URL(location.href);
      if (q.trim()) url.searchParams.set("q", q);
      else url.searchParams.delete("q");
      history.replaceState(history.state, "", url);
      sessionStorage.setItem("backUrl", url.pathname + url.search);
      run(root, q);
    };
    input.addEventListener("input", () => {
      clearTimeout(timer);
      timer = window.setTimeout(update, 120);
    });
    root.querySelector("form")!.addEventListener("submit", e => {
      e.preventDefault();
      update();
    });

    if (input.value) run(root, input.value);
    input.focus();
  }

  document.addEventListener("astro:page-load", setup);
</script>
