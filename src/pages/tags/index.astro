---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { CATEGORIES, categoryColorClass } from "@/utils/categories";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { slugifyAll } from "@/utils/slugify";
import { getPostsByLocale } from "@/utils/localePosts";
import { tplStr, useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const posts = getSortedPosts(await getPostsByLocale(locale));
const t = useTranslations(locale);

const categories = CATEGORIES.map(c => ({
  ...c,
  count: posts.filter(({ data }) => slugifyAll(data.tags).includes(c.slug)).length,
}));
---

<Layout title={`${t.pages.tagsTitle} | ${t.site.title}`}>
  <Header />


  <Main pageTitle={t.pages.tagsTitle} pageDesc={t.pages.tagsDesc}>
    <ul class="cat-list">
      {
        categories.map(c => (
          <li>
            <a
              href={getRelativeLocaleUrl(locale, `tags/${c.slug}/`)}
              class:list={["cat-row", categoryColorClass(c.slug), { "is-empty": c.count === 0 }]}
            >
              <div class="cat-row-main">
                <p class="cat-row-name">{c.name}</p>
                <p class="cat-row-desc">{t.categories.desc[c.slug]}</p>
              </div>
              <span class="cat-row-count">
                {c.count === 1 ? t.categories.countOne : tplStr(t.categories.count, { n: c.count })}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </Main>

  <Footer />
</Layout>
