---
// 做多 vs 做空：按交易顺序画两条累计 R，只在这个方向有交易的时候才动；每笔交易一个点。
// 用百分比定位的 HTML 画，文字在手机上不会跟着缩小；鼠标停在点上（手机上点一下）显示这笔交易。
import { useTranslations } from "@/i18n";
import { tplStr } from "@/i18n/format";
import { dirText } from "@/utils/rep20View";

type Trade = { n: number; date: string; entry: string; dir: string; setup: string; r: number; kind: string };
type Props = { trades: Trade[] };
const { trades } = Astro.props;
const s = useTranslations(Astro.currentLocale).rep20;

const ts = trades.filter(t => t.kind !== "rule");
const Y0 = -3;
const Y1 = 6;
const x = (i: number) => (i / ts.length) * 100;
const y = (r: number) => ((Y1 - r) / (Y1 - Y0)) * 100;
const signed = (v: number) => (v > 0 ? "+" : v < 0 ? "−" : "") + Math.abs(v).toFixed(2) + "R";

// 两条累计 R：第 i 笔之后，做空 / 做多各自的合计
const dirs = [
  { k: "short", d: "空", label: s.short },
  { k: "long", d: "多", label: s.long },
].map(o => {
  let sum = 0;
  const pts = [[0, 0], ...ts.map((t, i) => [i + 1, (sum += t.dir === o.d ? t.r : 0)])];
  const n = ts.filter(t => t.dir === o.d).length;
  return { ...o, n, sum, path: pts.map(([i, v], j) => `${j ? "L" : "M"}${x(i).toFixed(2)},${y(v).toFixed(2)}`).join("") };
});
let cum = { 空: 0, 多: 0 } as Record<string, number>;
const dots = ts.map((t, i) => ({ t, i: i + 1, c: (cum[t.dir] += t.r) }));
const marks = ts.flatMap((t, i) => ([1, 5, 10, 15, 20].includes(t.n) ? [[i + 1, t.n]] : []));
---

<figure class="dc" data-this={s.thisTrade} data-cum={s.dirCum}>
  <div class="fn-legend">
    {
      dirs.map(o => (
        <span>
          <i class={`dc-key-${o.k}`}></i>
          {tplStr(s.dirLegend, { label: o.label, n: o.n, sum: signed(o.sum) })}
        </span>
      ))
    }
  </div>
  <div class="dc-frame">
    <div class="dc-y">
      {[6, 4, 2, 0, -2].map(v => <span style={`top:${y(v)}%`}>{v > 0 ? `+${v}R` : v < 0 ? `−${-v}R` : "0"}</span>)}
    </div>
    <div class="dc-plot" role="img" aria-label={s.dcAria}>
      {[6, 4, 2, -2].map(v => <div class="dc-grid" style={`top:${y(v)}%`} />)}
      <div class="dc-zero" style={`top:${y(0)}%`} />
      <svg class="dc-lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        {dirs.map(o => <path class={`dc-line is-${o.k}`} d={o.path} vector-effect="non-scaling-stroke" />)}
      </svg>
      {
        dots.map(({ t, i, c }) => (
          <span
            class:list={["dc-dot", t.dir === "空" ? "is-short" : "is-long"]}
            style={`left:${x(i)}%;top:${y(c)}%`}
            tabindex="0"
            aria-label={`#${t.n} ${dirText(s, t.dir)} ${signed(t.r)}`}
            data-h={`#${t.n} · ${t.date} ${t.entry} · ${dirText(s, t.dir)}`}
            data-r={signed(t.r)}
            data-c={signed(c)}
            data-s={t.setup}
          />
        ))
      }
      <div class="fn-tip" hidden></div>
    </div>
    <div class="dc-x">
      {marks.map(([i, n]) => <span style={`left:${x(i)}%`}>#{n}</span>)}
    </div>
  </div>
  <figcaption class="fn-note">{s.dcNote}</figcaption>
</figure>

<script>
  // 指针停在点上（或键盘聚焦、手机上点一下）时显示提示框
  function setup() {
    document.querySelectorAll<HTMLElement>(".dc-plot").forEach(plot => {
      if (plot.dataset.ready) return;
      plot.dataset.ready = "1";
      const tip = plot.querySelector<HTMLElement>(".fn-tip")!;
      const fig = plot.closest<HTMLElement>(".dc")!.dataset;
      const show = (dot: HTMLElement) => {
        tip.innerHTML =
          `<p class="fn-tip-h">${dot.dataset.h}</p>` +
          `<p class="fn-tip-r">${fig.this}<b>${dot.dataset.r}</b></p>` +
          `<p class="fn-tip-r">${fig.cum}<b>${dot.dataset.c}</b></p>` +
          `<p class="fn-tip-h dc-tip-setup">${dot.dataset.s}</p>`;
        tip.hidden = false;
        const p = plot.getBoundingClientRect();
        const d = dot.getBoundingClientRect();
        const cx = d.left + d.width / 2 - p.left;
        const tw = tip.offsetWidth;
        tip.style.left = `${cx + 14 + tw > p.width ? cx - 14 - tw : cx + 14}px`;
        tip.style.top = `${Math.max(0, d.top + d.height / 2 - p.top - tip.offsetHeight / 2)}px`;
      };
      const hide = () => (tip.hidden = true);
      plot.querySelectorAll<HTMLElement>(".dc-dot").forEach(dot => {
        dot.addEventListener("pointerenter", () => show(dot));
        dot.addEventListener("pointerdown", () => show(dot));
        dot.addEventListener("focus", () => show(dot));
        dot.addEventListener("pointerleave", hide);
        dot.addEventListener("blur", hide);
      });
    });
  }

  document.addEventListener("astro:page-load", setup);
</script>

<style>
  .dc {
    margin: 1.5rem 0;
  }
  .dc-frame {
    position: relative;
    padding: 8px 12px 26px 44px;
  }
  .dc-plot {
    position: relative;
    height: 260px;
  }
  .dc-y span,
  .dc-x span {
    position: absolute;
    font-size: 12px;
    color: var(--faint);
    white-space: nowrap;
  }
  .dc-y {
    position: absolute;
    top: 8px;
    bottom: 26px;
    left: 0;
    width: 36px;
  }
  .dc-y span {
    right: 0;
    transform: translateY(-50%);
  }
  .dc-x {
    position: absolute;
    left: 44px;
    right: 12px;
    bottom: 0;
    height: 18px;
  }
  .dc-x span {
    transform: translateX(-50%);
  }
  .dc-grid,
  .dc-zero {
    position: absolute;
    left: 0;
    right: 0;
    border-top: 1px solid rgb(0 0 0 / 0.05);
  }
  .dc-zero {
    border-top-color: rgb(0 0 0 / 0.25);
  }
  .dc-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .dc-line {
    fill: none;
    stroke-width: 2;
    stroke-linejoin: round;
  }
  .dc-line.is-short {
    stroke: var(--accent);
  }
  .dc-line.is-long {
    stroke: #c4802b;
  }
  .dc-dot {
    position: absolute;
    width: 10px;
    height: 10px;
    margin: -5px 0 0 -5px;
    border-radius: 50%;
    box-shadow: 0 0 0 2px var(--background);
    cursor: default;
    transition: transform 0.12s ease;
  }
  .dc-dot:hover,
  .dc-dot:focus-visible {
    transform: scale(1.35);
    outline: none;
  }
  .dc-dot.is-short {
    background: var(--accent);
  }
  .dc-dot.is-long {
    background: #c4802b;
  }
  .dc-plot :global(.fn-tip p) {
    margin: 0;
  }
  .dc-plot :global(.fn-tip .dc-tip-setup) {
    margin: 4px 0 0 !important;
  }
  .fn-legend i.dc-key-short {
    background: var(--accent);
  }
  .fn-legend i.dc-key-long {
    background: #c4802b;
  }
</style>
