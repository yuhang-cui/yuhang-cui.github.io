---
// 标普500 价格指数对全收益指数：读者选起止年月，两条线在起点对齐到同一个值，
// 之后张开的口子就是股息再投资带来的那部分。上面两个按钮是常用起点：1871 年（数据最早）和 1957 年（标普500 诞生）。
// 数据在 public/data/spx-tr.json：Shiller 的月度数据，价格是当月均价，全收益按"每月股息再买入"滚出来。
import { useTranslations } from "@/i18n";

const s = useTranslations(Astro.currentLocale).spxTr;
const Y0 = 1871;
const Y1 = 2026;
const years = Array.from({ length: Y1 - Y0 + 1 }, (_, i) => Y0 + i);
const months = Array.from({ length: 12 }, (_, i) => i + 1);
---

<section class="bx st" aria-label={s.label} data-src={`${import.meta.env.BASE_URL}data/spx-tr.json`}>
  <div class="bx-controls">
    <div class="bx-switch">
      <button type="button" class="st-preset" data-y="1871" data-m="1" aria-pressed="false">{s.from1871}</button>
      <button type="button" class="st-preset" data-y="1957" data-m="3" aria-pressed="true">{s.from1957}</button>
    </div>
    <label class="bx-range">
      <span>{s.start}</span>
      <select class="st-y0" aria-label={s.start}>{years.map(y => <option value={y} selected={y === 1957}>{y}</option>)}</select>
      <select class="st-m0">{months.map(m => <option value={m} selected={m === 3}>{s.months[m - 1]}</option>)}</select>
    </label>
    <label class="bx-range">
      <span>{s.end}</span>
      <select class="st-y1" aria-label={s.end}>{years.map(y => <option value={y} selected={y === Y1}>{y}</option>)}</select>
      <select class="st-m1">{months.map(m => <option value={m} selected={m === 10}>{s.months[m - 1]}</option>)}</select>
    </label>
  </div>

  <div class="st-stats">
    <div class="st-stat" data-k="p">
      <p class="bx-hero-k"><i class="st-key"></i>{s.spx}</p>
      <p class="st-v">—</p>
      <p class="bx-hero-n">&nbsp;</p>
    </div>
    <div class="st-stat" data-k="tr">
      <p class="bx-hero-k"><i class="st-key"></i>{s.spxt}</p>
      <p class="st-v">—</p>
      <p class="bx-hero-n">&nbsp;</p>
    </div>
    <div class="st-stat" data-k="gap">
      <p class="bx-hero-k">{s.gap}</p>
      <p class="st-v">—</p>
      <p class="bx-hero-n">&nbsp;</p>
    </div>
  </div>

  <div class="fn-chart st-chart">
    <svg></svg>
    <div class="fn-tip" hidden></div>
  </div>
  <div class="st-foot">
    <button type="button" class="bx-reset st-log" aria-pressed="false">{s.log}</button>
  </div>

  <script type="application/json" class="st-strings" set:html={JSON.stringify(s)} />
</section>

<script>
  import { tplStr } from "@/i18n/format";

  type Data = { asOf: string; start: [number, number]; p: number[]; tr: number[] };
  type Strings = { spx: string; spxt: string; multiple: string; annual: string };
  const KEYS = ["p", "tr"] as const;
  const M = { l: 54, r: 48, t: 14, b: 26 };

  // 指数点位：两位有效数字就够看，4.4、44、440、4.4k、44k、1.2M
  const sig2 = (v: number) => (v < 10 ? v.toFixed(1).replace(/\.0$/, "") : String(Math.round(v)));
  const short = (v: number) => (v >= 1e6 ? sig2(v / 1e6) + "M" : v >= 1e3 ? sig2(v / 1e3) + "k" : sig2(v));
  const full = (v: number) => (v >= 100 ? Math.round(v).toLocaleString("en-US") : v.toFixed(2));
  const ym = (data: Data, i: number) => { const t = data.start[1] - 1 + i; return `${data.start[0] + Math.floor(t / 12)}-${String((t % 12) + 1).padStart(2, "0")}`; };
  const idx = (data: Data, y: number, m: number) => (y - data.start[0]) * 12 + (m - data.start[1]);

  function compute(data: Data, y0: number, m0: number, y1: number, m1: number) {
    const n = data.p.length;
    const i0 = Math.max(0, Math.min(n - 1, idx(data, y0, m0)));
    const i1 = Math.max(i0, Math.min(n - 1, idx(data, y1, m1)));
    if (i1 <= i0) return null;
    const yrs = (i1 - i0) / 12;
    // 全收益按比例缩到起点和价格指数同一个值
    const base = data.p[i0];
    const line = { p: data.p.slice(i0, i1 + 1), tr: data.tr.slice(i0, i1 + 1).map(v => (v / data.tr[i0]) * base) };
    const stats = Object.fromEntries(KEYS.map(k => { const mult = line[k][line[k].length - 1] / base; return [k, { mult, cagr: Math.pow(mult, 1 / yrs) - 1 }]; })) as Record<"p" | "tr", { mult: number; cagr: number }>;
    return { i0, i1, n: i1 - i0 + 1, line, stats, yrs };
  }
  type Result = NonNullable<ReturnType<typeof compute>>;

  function niceTicks(max: number) {
    const raw = max / 5;
    const p = Math.pow(10, Math.floor(Math.log10(raw)));
    const step = [1, 2, 2.5, 5, 10].map(m => m * p).find(v => v >= raw)!;
    const out: number[] = [];
    for (let v = 0; v <= max + 1e-9; v += step) out.push(v);
    return out;
  }
  // 对数刻度：按像素间距定格数，格与格之间等比，每格的值凑成两位有效数字
  function logTicks(min: number, max: number, plotH: number) {
    const n = Math.max(3, Math.floor(plotH / 30));
    const ratio = Math.pow(max / min, 1 / n);
    const out: number[] = [];
    for (let v = min; v <= max * 1.0001; v *= ratio) {
      const p = Math.pow(10, Math.floor(Math.log10(v)) - 1);
      const t = Math.round(v / p) * p;
      if (t >= min && t <= max && t !== out[out.length - 1]) out.push(t);
    }
    return out;
  }

  function draw(root: HTMLElement, data: Data, r: Result, s: Strings) {
    const svg = root.querySelector<SVGSVGElement>(".st-chart svg")!;
    const W = Math.max(280, Math.round(svg.parentElement!.clientWidth));
    const H = W < 520 ? 240 : 300;
    const log = root.dataset.log === "1";
    // 对数模式隔几个月取一个点，点之间连线
    const step = log ? Math.min(3, Math.max(1, Math.round(r.n / 100))) : 1;
    const pts: number[] = [];
    for (let j = 0; j < r.n; j += step) pts.push(j);
    if (pts[pts.length - 1] !== r.n - 1) pts.push(r.n - 1);
    const all = [...r.line.p, ...r.line.tr];
    const yMax = Math.max(...all) * (log ? 1.15 : 1.04);
    const yMin = log ? Math.min(...all) * 0.85 : 0;
    const plotH = H - M.t - M.b;
    const x = (j: number) => M.l + (j / Math.max(1, r.n - 1)) * (W - M.l - M.r);
    const y = (v: number) => (log ? M.t + (1 - (Math.log10(v) - Math.log10(yMin)) / (Math.log10(yMax) - Math.log10(yMin))) * plotH : M.t + (1 - v / yMax) * plotH);

    const yTicks = log ? logTicks(yMin, yMax, plotH) : niceTicks(yMax).filter(v => v > 0 || !log);
    // 年份标签：跨度大就隔 5、10、25、50 年一个，最后一个离右边太近就不画
    const t0 = data.start[1] - 1 + r.i0;
    const yA = data.start[0] + Math.floor(t0 / 12) + 1, yB = data.start[0] + Math.floor((t0 + r.n - 1) / 12);
    const span = yB - yA + 1;
    const stepY = [1, 2, 5, 10, 20, 25, 50].find(st => span / st <= 8) ?? 50;
    const yrs: number[] = [];
    for (let yy = Math.ceil(yA / stepY) * stepY; yy <= yB; yy += stepY) { const j = idx(data, yy, 1) - r.i0; if (j >= 0 && x(j) < W - M.r - 18) yrs.push(yy); }

    const path = (arr: number[]) => pts.map((j, k) => (k ? "L" : "M") + x(j).toFixed(1) + "," + y(arr[j]).toFixed(1)).join("");
    const labelY = KEYS.map(k => y(r.line[k][r.n - 1]));
    if (Math.abs(labelY[0] - labelY[1]) < 14) { const mid = (labelY[0] + labelY[1]) / 2, up = labelY[0] < labelY[1] ? 0 : 1; labelY[up] = mid - 7; labelY[1 - up] = mid + 7; }
    const names = { p: "SPX", tr: "SPXT" };

    svg.setAttribute("viewBox", `0 0 ${W} ${H}`);
    svg.setAttribute("width", String(W));
    svg.setAttribute("height", String(H));
    svg.classList.toggle("is-log", log);
    svg.innerHTML =
      yTicks.map(v => `<line class="fn-grid" x1="${M.l}" x2="${W - M.r}" y1="${y(v).toFixed(1)}" y2="${y(v).toFixed(1)}"/><text x="${M.l - 8}" y="${(y(v) + 4).toFixed(1)}" text-anchor="end">${short(v)}</text>`).join("") +
      yrs.map(yy => `<text x="${x(idx(data, yy, 1) - r.i0).toFixed(1)}" y="${H - 8}" text-anchor="middle">${yy}</text>`).join("") +
      `<line class="fn-axis" x1="${M.l}" x2="${W - M.r}" y1="${(M.t + plotH).toFixed(1)}" y2="${(M.t + plotH).toFixed(1)}"/>` +
      KEYS.map(k => `<path class="st-line" data-k="${k}" d="${path(r.line[k])}"/>`).join("") +
      (log ? KEYS.map(k => pts.map(j => `<circle class="st-pt" data-k="${k}" cx="${x(j).toFixed(1)}" cy="${y(r.line[k][j]).toFixed(1)}" r="2.3"/>`).join("")).join("") : "") +
      KEYS.map((k, i) => `<text class="st-lab" data-k="${k}" x="${(W - M.r + 6).toFixed(1)}" y="${(labelY[i] + 4).toFixed(1)}">${names[k]}</text>`).join("") +
      `<line class="fn-rule" y1="${M.t}" y2="${H - M.b}"/>` +
      KEYS.map(k => `<circle class="fn-dot" data-k="${k}" r="4"/>`).join("");

    // 十字线 + 提示框：按横坐标找最近的月份（对数模式只在取样的点之间挑）
    const tip = root.querySelector<HTMLElement>(".fn-tip")!;
    const rule = svg.querySelector<SVGLineElement>(".fn-rule")!;
    const dots = KEYS.map(k => svg.querySelector<SVGCircleElement>(`.fn-dot[data-k="${k}"]`)!);
    const show = (e: PointerEvent) => {
      const rect = svg.getBoundingClientRect();
      const px = ((e.clientX - rect.left) / rect.width) * W;
      const jj = ((px - M.l) / (W - M.l - M.r)) * (r.n - 1);
      const j = pts.reduce((best, q) => (Math.abs(q - jj) < Math.abs(best - jj) ? q : best), pts[0]);
      const xx = x(j);
      rule.setAttribute("x1", String(xx)); rule.setAttribute("x2", String(xx));
      KEYS.forEach((k, n) => { dots[n].setAttribute("cx", String(xx)); dots[n].setAttribute("cy", String(y(r.line[k][j]))); });
      svg.classList.add("is-hover");
      tip.replaceChildren();
      const h = document.createElement("p"); h.className = "fn-tip-h"; h.textContent = ym(data, r.i0 + j); tip.append(h);
      KEYS.forEach(k => {
        const p = document.createElement("p"); p.className = "fn-tip-r";
        const key = document.createElement("i"); key.className = `st-key-${k}`;
        const b = document.createElement("b"); b.textContent = full(r.line[k][j]) + (j ? "  ×" + (r.line[k][j] / r.line[k][0]).toFixed(2) : "");
        p.append(key, document.createTextNode(k === "p" ? s.spx : s.spxt), b); tip.append(p);
      });
      tip.hidden = false;
      const left = (xx / W) * rect.width;
      const tw = tip.offsetWidth;
      tip.style.left = `${left + 14 + tw > rect.width ? left - 14 - tw : left + 14}px`;
      tip.style.top = `${Math.max(0, ((e.clientY - rect.top) / rect.height) * H - 30)}px`;
    };
    const hide = () => { svg.classList.remove("is-hover"); tip.hidden = true; };
    svg.onpointermove = show; svg.onpointerdown = show; svg.onpointerleave = hide;
  }

  function fillStats(root: HTMLElement, r: Result | null, s: Strings) {
    const set = (k: string, v: string, n: string) => { const st = root.querySelector<HTMLElement>(`.st-stat[data-k="${k}"]`)!; st.querySelector(".st-v")!.textContent = v; st.querySelector(".bx-hero-n")!.textContent = n; };
    if (!r) { ["p", "tr", "gap"].forEach(k => set(k, "—", " ")); return; }
    const pct = (v: number) => (v * 100).toFixed(1) + "%";
    KEYS.forEach(k => set(k, tplStr(s.multiple, { x: r.stats[k].mult.toFixed(1) }), tplStr(s.annual, { r: pct(r.stats[k].cagr) })));
    set("gap", tplStr(s.multiple, { x: (r.stats.tr.mult / r.stats.p.mult).toFixed(1) }), tplStr(s.annual, { r: "+" + pct(r.stats.tr.cagr - r.stats.p.cagr) }));
  }

  async function setup() {
    for (const root of document.querySelectorAll<HTMLElement>(".st")) {
      if (root.dataset.ready) continue;
      root.dataset.ready = "1";
      const s = JSON.parse(root.querySelector(".st-strings")!.textContent!) as Strings;
      const data = (await (await fetch(root.dataset.src!)).json()) as Data;
      const q = <T extends Element>(c: string) => root.querySelector<T>(c)!;
      const y0 = q<HTMLSelectElement>(".st-y0"), m0 = q<HTMLSelectElement>(".st-m0"), y1 = q<HTMLSelectElement>(".st-y1"), m1 = q<HTMLSelectElement>(".st-m1");
      const svg = q<SVGSVGElement>(".st-chart svg");
      const presets = Array.from(root.querySelectorAll<HTMLButtonElement>(".st-preset"));
      const run = () => {
        let a = +y0.value, b = +m0.value, c = +y1.value, d = +m1.value;
        if (c < a || (c === a && d < b)) { c = a; d = b; y1.value = String(c); m1.value = String(d); }
        presets.forEach(btn => btn.setAttribute("aria-pressed", String(+btn.dataset.y! === a && +btn.dataset.m! === b)));
        const r = compute(data, a, b, c, d);
        fillStats(root, r, s);
        if (r) draw(root, data, r, s); else svg.innerHTML = "";
      };
      [y0, m0, y1, m1].forEach(el => el.addEventListener("change", run));
      presets.forEach(btn => btn.addEventListener("click", () => { y0.value = btn.dataset.y!; m0.value = btn.dataset.m!; run(); }));
      const logBtn = q<HTMLButtonElement>(".st-log");
      logBtn.addEventListener("click", () => {
        const on = root.dataset.log !== "1";
        root.dataset.log = on ? "1" : "0";
        logBtn.setAttribute("aria-pressed", String(on));
        run();
      });
      run();
      let lastW = svg.parentElement!.clientWidth;
      new ResizeObserver(() => { const w = Math.round(svg.parentElement!.clientWidth); if (w && w !== lastW) { lastW = w; run(); } }).observe(svg.parentElement!);
    }
  }
  document.addEventListener("astro:page-load", setup);
</script>

<style is:global>
  .st {
    --c-p: #016dac;
    --c-tr: #c2353c;
  }
  [data-theme="dark"] .st {
    --c-p: #5595c8;
    --c-tr: #e06a6a;
  }
  .st .bx-controls {
    margin-bottom: 18px;
  }
  .st .bx-range select {
    padding-right: 6px;
  }
  .st-foot {
    display: flex;
    justify-content: flex-end;
    margin-top: 10px;
  }
  .st-log[aria-pressed="true"] {
    border-color: var(--foreground);
    background: var(--foreground);
    color: var(--background);
  }
  .st-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px 20px;
    margin-bottom: 14px;
  }
  .st-stat .bx-hero-k {
    display: flex;
    align-items: center;
    gap: 7px;
  }
  .st-key,
  .fn-tip-r i[class^="st-key"] {
    display: inline-block;
    width: 14px;
    height: 3px;
    border-radius: 2px;
  }
  .st-stat[data-k="p"] .st-key,
  .fn-tip-r .st-key-p { background: var(--c-p); }
  .st-stat[data-k="tr"] .st-key,
  .fn-tip-r .st-key-tr { background: var(--c-tr); }
  .st-v {
    margin-top: 2px !important;
    font-size: 26px;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--foreground);
  }
  .st-line {
    fill: none;
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .st svg.is-log .st-line { stroke-width: 1.25; }
  .st-line[data-k="p"] { stroke: var(--c-p); }
  .st-line[data-k="tr"] { stroke: var(--c-tr); }
  .st-pt[data-k="p"] { fill: var(--c-p); }
  .st-pt[data-k="tr"] { fill: var(--c-tr); }
  .st-lab { font-size: 12px; font-weight: 600; }
  .st-lab[data-k="p"] { fill: var(--c-p); }
  .st-lab[data-k="tr"] { fill: var(--c-tr); }
  .st .fn-dot { stroke: var(--card); stroke-width: 2; }
  .st .fn-dot[data-k="p"] { fill: var(--c-p); }
  .st .fn-dot[data-k="tr"] { fill: var(--c-tr); }
  @media (max-width: 560px) {
    .st-stats {
      grid-template-columns: 1fr 1fr;
    }
    .st-stats .st-stat:last-child {
      grid-column: 1 / -1;
    }
    .st-v {
      font-size: 22px;
    }
  }
</style>
