---
// 例图卡片：一张大图、下面一排缩略图、每张图自己的说明。按钮或左右方向键切换（鼠标在卡片上或卡片有焦点时），手机上可以左右滑。
// 用法（MDX）：import a from "./cases/a.webp"; <ImageCases title="…" items={[{ img: a, alt: "…", note: "…" }]} />
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { useTranslations } from "@/i18n";
import { tplStr } from "@/i18n/format";

interface Item { img: ImageMetadata; alt: string; note?: string }
interface Props { title?: string; items: Item[] }
const { title, items } = Astro.props;
const s = useTranslations(Astro.currentLocale).cases;
---

<section class="ic" aria-label={title ?? s.label} tabindex="0" data-n={items.length}>
  <div class="ic-head">
    <p class="ic-title">{title ?? s.label}</p>
    <div class="ic-nav">
      <span class="ic-hint">{s.hint}</span>
      <span class="ic-counter">{tplStr(s.counter, { i: 1, n: items.length })}</span>
      <button type="button" class="ic-prev" aria-label={s.prev}>‹</button>
      <button type="button" class="ic-next" aria-label={s.next}>›</button>
    </div>
  </div>
  <div class="ic-stage">
    {items.map((it, k) => (
      <figure class="ic-slide" data-k={k} hidden={k !== 0}>
        <Image src={it.img} alt={it.alt} widths={[720, 1200, 1600]} sizes="(max-width: 760px) 100vw, 720px" loading={k === 0 ? "eager" : "lazy"} />
        {it.note && <figcaption class="ic-note" set:html={it.note} />}
      </figure>
    ))}
  </div>
  {items.length > 1 && (
    <div class="ic-thumbs" role="tablist">
      {items.map((it, k) => (
        <button type="button" role="tab" class="ic-thumb" data-k={k} aria-selected={k === 0 ? "true" : "false"} aria-label={it.alt}>
          <Image src={it.img} alt="" width={240} loading="lazy" />
        </button>
      ))}
    </div>
  )}
  <script type="application/json" class="ic-strings" set:html={JSON.stringify({ counter: s.counter })} />
</section>

<script>
  import { tplStr } from "@/i18n/format";

  function setup() {
    for (const root of document.querySelectorAll<HTMLElement>(".ic")) {
      if (root.dataset.ready) continue;
      root.dataset.ready = "1";
      const n = Number(root.dataset.n);
      const { counter } = JSON.parse(root.querySelector(".ic-strings")!.textContent!) as { counter: string };
      const slides = Array.from(root.querySelectorAll<HTMLElement>(".ic-slide"));
      const thumbs = Array.from(root.querySelectorAll<HTMLButtonElement>(".ic-thumb"));
      const count = root.querySelector<HTMLElement>(".ic-counter")!;
      let cur = 0;
      const go = (k: number) => {
        cur = ((k % n) + n) % n;
        slides.forEach((el, i) => { el.hidden = i !== cur; });
        thumbs.forEach((el, i) => el.setAttribute("aria-selected", i === cur ? "true" : "false"));
        thumbs[cur]?.scrollIntoView({ block: "nearest", inline: "nearest", behavior: "smooth" });
        count.textContent = tplStr(counter, { i: cur + 1, n });
      };
      root.querySelector(".ic-prev")!.addEventListener("click", () => go(cur - 1));
      root.querySelector(".ic-next")!.addEventListener("click", () => go(cur + 1));
      thumbs.forEach((el, i) => el.addEventListener("click", () => go(i)));
      // 左右方向键：鼠标停在卡片上，或者点过卡片（有焦点）时才生效，不打扰页面别的地方
      window.addEventListener("keydown", e => {
        if (e.key !== "ArrowLeft" && e.key !== "ArrowRight") return;
        const t = e.target;
        if (t instanceof HTMLElement && (t.closest("input, textarea, select") || t.isContentEditable)) return;
        if (!(root.matches(":hover") || root.contains(document.activeElement))) return;
        e.preventDefault();
        go(cur + (e.key === "ArrowRight" ? 1 : -1));
      });
      // 手机：在大图上左右滑
      const stage = root.querySelector<HTMLElement>(".ic-stage")!;
      let x0: number | null = null;
      stage.addEventListener("touchstart", e => { x0 = e.touches[0].clientX; }, { passive: true });
      stage.addEventListener("touchend", e => {
        if (x0 === null) return;
        const dx = e.changedTouches[0].clientX - x0; x0 = null;
        if (Math.abs(dx) > 40) go(cur + (dx < 0 ? 1 : -1));
      });
    }
  }
  document.addEventListener("astro:page-load", setup);
</script>

<style is:global>
  .app-prose .ic {
    margin: 1.75rem 0;
    padding: 14px 16px 16px;
    border: 1px solid rgb(0 0 0 / 0.09);
    border-radius: 16px;
    background: #fbfbf9;
    outline: none;
  }
  .app-prose .ic:focus-visible { box-shadow: 0 0 0 2px var(--accent); }
  .ic-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 10px;
  }
  .app-prose .ic-title {
    margin: 0;
    font-size: 14px;
    font-weight: 600;
    color: var(--foreground);
  }
  .ic-nav {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: var(--faint);
    font-variant-numeric: tabular-nums;
  }
  .ic-hint { margin-right: 4px; }
  .ic-counter { margin-right: 4px; color: var(--summary); }
  .ic-nav button {
    width: 28px;
    height: 28px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--card);
    font-size: 18px;
    line-height: 1;
    color: var(--foreground);
    cursor: pointer;
  }
  .ic-nav button:hover { border-color: var(--muted-foreground); }
  .app-prose .ic-slide { margin: 0; }
  .app-prose .ic-slide img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 10px;
    border: 1px solid rgb(0 0 0 / 0.07);
    background: #fff;
  }
  .app-prose .ic-note {
    margin: 10px 2px 0;
    font-size: 13.5px;
    line-height: 1.65;
    color: var(--prose);
  }
  .ic-thumbs {
    display: flex;
    gap: 8px;
    margin-top: 12px;
    overflow-x: auto;
    padding-bottom: 2px;
    scrollbar-width: thin;
  }
  .ic-thumb {
    flex: 0 0 96px;
    padding: 0;
    border: 2px solid transparent;
    border-radius: 8px;
    background: #f1efe9;
    cursor: pointer;
    overflow: hidden;
  }
  .ic-thumb img {
    display: block;
    width: 100%;
    height: 54px;
    object-fit: cover;
    opacity: 0.75;
  }
  .ic-thumb[aria-selected="true"] { border-color: var(--accent); }
  .ic-thumb[aria-selected="true"] img, .ic-thumb:hover img { opacity: 1; }
  @media (max-width: 560px) {
    .ic-hint { display: none; }
    .app-prose .ic { padding: 12px 12px 14px; }
    .ic-thumb { flex-basis: 76px; }
    .ic-thumb img { height: 44px; }
  }
</style>
