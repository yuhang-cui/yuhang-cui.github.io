---
// 20 均线：可选年份；鼠标移到曲线上看到第几根已经碰过均线、离开均线连续多少根以上的占比。
import data from "@/data/ema-touch.json";
import { renderEma, years, type EmaData } from "@/utils/emaView";
import { useTranslations } from "@/i18n";
import { tplStr } from "@/i18n/format";

const t = useTranslations(Astro.currentLocale);
const s = t.ema;
const b = t.breakout;
const d = data as EmaData;
const ys = years(d);
const y0 = ys[0];
const y1 = ys[ys.length - 1];
const c = { yearRange: b.yearRange, singleYear: b.singleYear, thousands: b.thousands };
---

<section class="bx zx ex" data-y0={y0} data-y1={y1} aria-label={s.label}>
  <div class="bx-controls">
    <label class="bx-range">
      <select class="bx-y0" aria-label={b.fromYear}>
        {ys.map(y => <option value={y} selected={y === y0}>{y}</option>)}
      </select>
      <span>–</span>
      <select class="bx-y1" aria-label={b.toYear}>
        {ys.map(y => <option value={y} selected={y === y1}>{y}</option>)}
      </select>
    </label>
    <button type="button" class="bx-reset">{b.allYears}</button>
  </div>

  <div class="ex-view" set:html={renderEma(d, s, c, tplStr(b.yearRange, { a: y0, b: y1 }), y0, y1, 640)} />

  <script type="application/json" class="ex-data" set:html={JSON.stringify({ data: d, s, c })} />
</section>

<script>
  import { tplStr } from "@/i18n/format";
  import { groupNum } from "@/utils/breakoutView";
  import { mount, bindHover, placeTip, svgX, rangeLabel, pc1, share, barEnd } from "@/utils/chartKit";
  import { renderEma, pool, fx, fy, sx, sy, FB, SB, BARS, MAXL, type EmaData, type EmaStrings, type EmaText } from "@/utils/emaView";

  type Payload = { data: EmaData; s: EmaStrings; c: EmaText };

  function setup() {
    document.querySelectorAll<HTMLElement>(".ex").forEach(root => {
      if (root.dataset.ready) return;
      root.dataset.ready = "1";
      const { data, s, c }: Payload = JSON.parse(root.querySelector(".ex-data")!.textContent!);
      const view = root.querySelector<HTMLElement>(".ex-view")!;

      mount(root, view, ({ y0, y1 }, w) => {
        view.innerHTML = renderEma(data, s, c, rangeLabel(c, y0, y1), y0, y1, w);
        const st = pool(data, y0, y1);

        // 第一次碰到：指针在第几根，就显示到这根为止碰过的比例
        const fb = view.querySelector<HTMLElement>(".ex-first-box")!;
        const fsvg = fb.querySelector("svg")!;
        const ftip = fb.querySelector<HTMLElement>(".fn-tip")!;
        const frule = fsvg.querySelector<SVGLineElement>(".fn-rule")!;
        const fdot = fsvg.querySelector<SVGCircleElement>(".ex-dot")!;
        bindHover(
          fb,
          e => {
            const n = Math.round(((svgX(fsvg, w, e) - FB.l) / (w - FB.l - FB.r)) * (BARS - 1)) + 1;
            if (n < 1 || n > BARS) return false;
            const v = share(st.cum[n - 1], st.days);
            frule.setAttribute("x1", String(fx(n, w)));
            frule.setAttribute("x2", String(fx(n, w)));
            fdot.setAttribute("cx", String(fx(n, w)));
            fdot.setAttribute("cy", String(fy(v)));
            fsvg.classList.add("is-hover");
            ftip.innerHTML =
              `<p class="fn-tip-h">${tplStr(s.bar, { n, t: `${barEnd(n - 2)}–${barEnd(n - 1)}` })}</p>` +
              `<p class="fn-tip-r">${s.cumTip}<b>${pc1(v)}</b></p>` +
              `<p class="fn-tip-r">${s.atTip}<b>${pc1(share(st.first[n - 1], st.days))}</b></p>`;
            placeTip(ftip, fsvg, fx(n, w), w, e);
          },
          () => {
            fsvg.classList.remove("is-hover");
            ftip.hidden = true;
          }
        );

        // 连续根数：指针在 L，就显示连续 L 根以上的段数占比
        const sb = view.querySelector<HTMLElement>(".ex-streak-box")!;
        const ssvg = sb.querySelector("svg")!;
        const stip = sb.querySelector<HTMLElement>(".fn-tip")!;
        const srule = ssvg.querySelector<SVGLineElement>(".fn-rule")!;
        bindHover(
          sb,
          e => {
            const L = Math.round(((svgX(ssvg, w, e) - SB.l) / (w - SB.l - SB.r)) * (MAXL - 1)) + 1;
            if (L < 1 || L > MAXL) return false;
            srule.setAttribute("x1", String(sx(L, w)));
            srule.setAttribute("x2", String(sx(L, w)));
            const row = (k: "up" | "dn", label: string) => {
              const v = share(st[k][L], st[k][1]);
              const dot = ssvg.querySelector<SVGCircleElement>(`.ex-${k}-dot`)!;
              dot.setAttribute("cx", String(sx(L, w)));
              dot.setAttribute("cy", String(sy(v)));
              return `<p class="fn-tip-r"><i class="ex-key-${k}"></i>${label}<b>${pc1(v)} · ${tplStr(s.segs, { n: groupNum(st[k][L], c.thousands), t: groupNum(st[k][1], c.thousands) })}</b></p>`;
            };
            ssvg.classList.add("is-hover");
            stip.innerHTML = `<p class="fn-tip-h">${tplStr(s.atLeast, { n: L })}</p>` + row("up", s.above) + row("dn", s.below);
            placeTip(stip, ssvg, sx(L, w), w, e);
          },
          () => {
            ssvg.classList.remove("is-hover");
            stip.hidden = true;
          }
        );
      });
    });
  }

  document.addEventListener("astro:page-load", setup);
</script>
