---
// 今天能走出昨日区间几倍：可以按昨天的 K 线、昨天收在哪里、今天开在哪里分组，也可以选年份；鼠标移到图上看走到某个倍数的比例。
import data from "@/data/yesterday-mm.json";
import { renderMm, years, GROUPS, type MmData } from "@/utils/mmView";
import { useTranslations } from "@/i18n";
import { tplStr } from "@/i18n/format";

const t = useTranslations(Astro.currentLocale);
const s = t.mm;
const b = t.breakout;
const d = data as MmData;
const ys = years(d);
const y0 = ys[0];
const y1 = ys[ys.length - 1];
const c = { yearRange: b.yearRange, singleYear: b.singleYear, thousands: b.thousands };
---

<section class="bx zx mx" data-y0={y0} data-y1={y1} aria-label={s.label}>
  <div class="bx-controls">
    <label class="bx-range">
      <select class="mx-cond" data-k="cond" aria-label={s.condLabel}>
        {
          GROUPS.map(({ g, conds }) =>
            g ? (
              <optgroup label={s[g]}>
                {conds.map(k => <option value={k}>{s[k]}</option>)}
              </optgroup>
            ) : (
              conds.map(k => <option value={k} selected>{s[k]}</option>)
            )
          )
        }
      </select>
    </label>
    <label class="bx-range">
      <select class="bx-y0" aria-label={b.fromYear}>
        {ys.map(y => <option value={y} selected={y === y0}>{y}</option>)}
      </select>
      <span>–</span>
      <select class="bx-y1" aria-label={b.toYear}>
        {ys.map(y => <option value={y} selected={y === y1}>{y}</option>)}
      </select>
    </label>
    <button type="button" class="bx-reset">{b.allYears}</button>
  </div>

  <div class="mx-view" set:html={renderMm(d, s, c, tplStr(b.yearRange, { a: y0, b: y1 }), "all", y0, y1, 640)} />

  <script type="application/json" class="mx-data" set:html={JSON.stringify({ data: d, s, c })} />
</section>

<script>
  import { tplStr } from "@/i18n/format";
  import { groupNum } from "@/utils/breakoutView";
  import { mount, bindHover, placeTip, svgX, rangeLabel, pc1, share } from "@/utils/chartKit";
  import { renderMm, pool, kText, mx, my, B, STEPS, LINES, type MmData, type MmStrings, type MmText } from "@/utils/mmView";

  type Payload = { data: MmData; s: MmStrings; c: MmText };

  function setup() {
    document.querySelectorAll<HTMLElement>(".mx").forEach(root => {
      if (root.dataset.ready) return;
      root.dataset.ready = "1";
      const { data, s, c }: Payload = JSON.parse(root.querySelector(".mx-data")!.textContent!);
      const view = root.querySelector<HTMLElement>(".mx-view")!;

      mount(root, view, ({ y0, y1, opt }, w) => {
        view.innerHTML = renderMm(data, s, c, rangeLabel(c, y0, y1), opt.cond, y0, y1, w);
        const st = pool(data, opt.cond, y0, y1);
        const box = view.querySelector<HTMLElement>(".mx-box")!;
        const svg = box.querySelector("svg")!;
        const tip = box.querySelector<HTMLElement>(".fn-tip")!;
        const rule = svg.querySelector<SVGLineElement>(".fn-rule")!;
        const names = { u: s.up, d: s.down, e: s.either };

        // 指针在哪个倍数，就显示向上、向下、至少一边打到的比例
        bindHover(
          box,
          e => {
            const j = Math.round(((svgX(svg, w, e) - B.l) / (w - B.l - B.r)) * STEPS);
            if (j < 0 || j > STEPS) return false;
            rule.setAttribute("x1", String(mx(j, w)));
            rule.setAttribute("x2", String(mx(j, w)));
            svg.classList.add("is-hover");
            let rows = "";
            for (const { k, cls } of LINES) {
              const v = share(st[k][j], st.n) || 0;
              const dot = svg.querySelector<SVGCircleElement>(`.fn-dot[data-k=${k}]`)!;
              dot.setAttribute("cx", String(mx(j, w)));
              dot.setAttribute("cy", String(my(v)));
              rows += `<p class="fn-tip-r"><i class="${cls.replace("mx-", "mx-key-")}"></i>${names[k]}<b>${pc1(v)}</b></p>`;
            }
            tip.innerHTML =
              `<p class="fn-tip-h">${j ? tplStr(s.tipHead, { k: kText(j) }) : s.tipHead0} · ${tplStr(s.days, { n: groupNum(st.n, c.thousands) })}</p>` + rows;
            placeTip(tip, svg, mx(j, w), w, e);
          },
          () => {
            svg.classList.remove("is-hover");
            tip.hidden = true;
          }
        );
      });
    });
  }

  document.addEventListener("astro:page-load", setup);
</script>
