---
// 定投回测：IVV 对 QQQ。读者选开始年月、结束年月、每月几号买、每月投多少美元，
// 图上画三条线：累计投入（灰虚线）、IVV 市值（蓝）、QQQ 市值（红），上面三个数字跟着变。
// 数据在 public/data/dca.json（Yahoo 日线复权价，股息按再投资折进去了），页面加载后再取；
// 选的日子碰到周末或假日就顺延到下一个交易日买。年化是资金加权收益率（按实际现金流解出来的）。
import { useTranslations } from "@/i18n";

const s = useTranslations(Astro.currentLocale).dca;
const Y0 = 2000;
const Y1 = 2026;
const years = Array.from({ length: Y1 - Y0 + 1 }, (_, i) => Y0 + i);
const months = Array.from({ length: 12 }, (_, i) => i + 1);
const days = Array.from({ length: 28 }, (_, i) => i + 1);
---

<section class="bx dca" aria-label={s.label} data-src={`${import.meta.env.BASE_URL}data/dca.json`}>
  <div class="bx-controls">
    <label class="bx-range">
      <span>{s.start}</span>
      <select class="dca-y0" aria-label={s.start}>{years.map(y => <option value={y} selected={y === 2000}>{y}</option>)}</select>
      <select class="dca-m0">{months.map(m => <option value={m} selected={m === 6}>{s.months[m - 1]}</option>)}</select>
    </label>
    <label class="bx-range">
      <span>{s.end}</span>
      <select class="dca-y1" aria-label={s.end}>{years.map(y => <option value={y} selected={y === Y1}>{y}</option>)}</select>
      <select class="dca-m1">{months.map(m => <option value={m} selected={m === 10}>{s.months[m - 1]}</option>)}</select>
    </label>
    <label class="bx-range">
      <span>{s.day}</span>
      <select class="dca-d" aria-label={s.day}>{days.map(d => <option value={d}>{d}</option>)}</select>
      <span>{s.dayUnit}</span>
    </label>
    <label class="bx-range">
      <span>{s.amount}</span>
      <span class="dca-amt"><i>$</i><input class="dca-a" type="number" min="1" step="50" value="500" inputmode="numeric" aria-label={s.amount} /></span>
    </label>
    <div class="bx-switch dca-cur">
      <button type="button" data-cur="usd" aria-pressed="true" aria-label="USD">$</button>
      <button type="button" data-cur="cny" aria-pressed="false" aria-label="CNY">¥</button>
    </div>
  </div>

  <div class="dca-stats">
    <div class="dca-stat">
      <p class="bx-hero-k">{s.invested}</p>
      <p class="dca-v dca-in">—</p>
      <p class="bx-hero-n dca-in-n">&nbsp;</p>
    </div>
    <div class="dca-stat" data-k="IVV">
      <p class="bx-hero-k"><i class="dca-key"></i>{s.ivv}</p>
      <p class="dca-v">—</p>
      <p class="bx-hero-n">&nbsp;</p>
    </div>
    <div class="dca-stat" data-k="QQQ">
      <p class="bx-hero-k"><i class="dca-key"></i>{s.qqq}</p>
      <p class="dca-v">—</p>
      <p class="bx-hero-n">&nbsp;</p>
    </div>
  </div>

  <div class="fn-chart dca-chart">
    <svg></svg>
    <div class="fn-tip" hidden></div>
  </div>
  <div class="dca-foot">
    <button type="button" class="bx-reset dca-reset">{s.reset}</button>
    <button type="button" class="bx-reset dca-log" aria-pressed="false">{s.log}</button>
  </div>

  <script type="application/json" class="dca-strings" set:html={JSON.stringify(s)} />
</section>

<script>
  import { tplStr } from "@/i18n/format";

  type Data = { asOf: string; days: number[]; IVV: number[]; QQQ: number[] };
  type Strings = {
    invested: string; months: string[]; monthsCount: string; multiple: string; annual: string; ivv: string; qqq: string;
  };
  const KEYS = ["IVV", "QQQ"] as const;
  const DAY = 86400000;
  const M = { l: 54, r: 44, t: 14, b: 26 };

  // 货币符号：美元 $ 或人民币 ¥，只影响显示和默认的每月金额，数据本身不换算
  let SYM = "$";
  const money = (v: number) => SYM + Math.round(v).toLocaleString("en-US");
  const short = (v: number) => (v >= 1e6 ? SYM + (v / 1e6).toFixed(v >= 1e7 ? 0 : 1) + "M" : v >= 1e3 ? SYM + Math.round(v / 1e3) + "k" : SYM + Math.round(v));
  // 对数刻度的标签：两位有效数字，$1.3k、$18k、$230k、$1.3M
  const sig2 = (v: number) => (v < 10 ? v.toFixed(1).replace(/\.0$/, "") : String(Math.round(v)));
  const shortLog = (v: number) => (v >= 1e6 ? SYM + sig2(v / 1e6) + "M" : v >= 1e3 ? SYM + sig2(v / 1e3) + "k" : SYM + Math.round(v));
  const iso = (d: number) => new Date(d * DAY).toISOString().slice(0, 10);
  // 第一个 >= 目标日的交易日下标
  const lowerBound = (days: number[], target: number) => {
    let lo = 0, hi = days.length;
    while (lo < hi) { const mid = (lo + hi) >> 1; if (days[mid] < target) lo = mid + 1; else hi = mid; }
    return lo;
  };
  const utcDay = (y: number, m: number, d: number) => Date.UTC(y, m - 1, d) / DAY;
  const dim = (y: number, m: number) => new Date(Date.UTC(y, m, 0)).getUTCDate();

  // 资金加权年化：解 Σ amt·(1+r)^((T−tᵢ)/365.25) = 终值 的 r
  function irr(buys: number[], T: number, amt: number, value: number) {
    if (!buys.length || value <= 0) return NaN;
    const f = (r: number) => buys.reduce((a, t) => a + amt * Math.pow(1 + r, (T - t) / 365.25), 0) - value;
    let lo = -0.95, hi = 5;
    if (f(lo) > 0 || f(hi) < 0) return NaN;
    for (let i = 0; i < 80; i++) { const mid = (lo + hi) / 2; if (f(mid) > 0) hi = mid; else lo = mid; }
    return (lo + hi) / 2;
  }

  function compute(data: Data, y0: number, m0: number, y1: number, m1: number, day: number, amt: number) {
    const { days } = data;
    const endIdx = Math.min(days.length - 1, lowerBound(days, utcDay(y1, m1, dim(y1, m1)) + 1) - 1);
    const buyIdx: number[] = [];
    for (let y = y0, m = m0; y < y1 || (y === y1 && m <= m1); m === 12 ? (y++, (m = 1)) : m++) {
      const i = lowerBound(days, utcDay(y, m, Math.min(day, dim(y, m))));
      if (i > endIdx) break;
      if (!buyIdx.length || i !== buyIdx[buyIdx.length - 1]) buyIdx.push(i);
    }
    if (!buyIdx.length) return null;
    const i0 = buyIdx[0];
    const n = endIdx - i0 + 1;
    const invested = new Float64Array(n);
    const value = { IVV: new Float64Array(n), QQQ: new Float64Array(n) };
    const units = { IVV: 0, QQQ: 0 };
    let inv = 0, b = 0;
    for (let i = i0; i <= endIdx; i++) {
      while (b < buyIdx.length && buyIdx[b] === i) { inv += amt; for (const k of KEYS) units[k] += amt / data[k][i]; b++; }
      invested[i - i0] = inv;
      for (const k of KEYS) value[k][i - i0] = units[k] * data[k][i];
    }
    const T = days[endIdx];
    const buysT = buyIdx.map(i => days[i]);
    const stats = Object.fromEntries(KEYS.map(k => {
      const v = value[k][n - 1];
      return [k, { value: v, mult: v / inv, irr: irr(buysT, T, amt, v) }];
    })) as Record<(typeof KEYS)[number], { value: number; mult: number; irr: number }>;
    return { i0, endIdx, n, invested, value, inv, buys: buyIdx.length, buyIdx, stats };
  }

  type Result = NonNullable<ReturnType<typeof compute>>;

  function niceTicks(max: number) {
    const raw = max / 5;
    const p = Math.pow(10, Math.floor(Math.log10(raw)));
    const step = [1, 2, 2.5, 5, 10].map(m => m * p).find(v => v >= raw)!;
    const out: number[] = [];
    for (let v = 0; v <= max + 1e-9; v += step) out.push(v);
    return out;
  }

  // 对数刻度：学 TradingView 的做法，按像素间距定格数，格与格之间等比，每格的值凑成两位有效数字
  function logTicks(min: number, max: number, plotH: number) {
    const n = Math.max(3, Math.floor(plotH / 30));
    const ratio = Math.pow(max / min, 1 / n);
    const out: number[] = [];
    for (let v = min; v <= max * 1.0001; v *= ratio) {
      const p = Math.pow(10, Math.floor(Math.log10(v)) - 1);
      const t = Math.round(v / p) * p;
      if (t >= min && t <= max && t !== out[out.length - 1]) out.push(t);
    }
    return out;
  }

  function draw(root: HTMLElement, data: Data, r: Result, s: Strings) {
    const svg = root.querySelector<SVGSVGElement>(".dca-chart svg")!;
    const W = Math.max(280, Math.round(svg.parentElement!.clientWidth));
    const H = W < 520 ? 240 : 300;
    const { days } = data;
    const d0 = days[r.i0], d1 = days[r.endIdx];
    const log = root.dataset.log === "1";
    // 对数模式不画每一天：按买入日隔几个月取一个点，点之间连线，像 TradingView 的月线那样看得清
    const step = log ? Math.min(3, Math.max(1, Math.round(r.buyIdx.length / 100))) : 1;
    const pts: number[] = [];
    if (log) {
      r.buyIdx.forEach((i, k) => { if (k % step === 0) pts.push(i); });
      if (pts[pts.length - 1] !== r.endIdx) pts.push(r.endIdx);
    } else for (let i = r.i0; i <= r.endIdx; i++) pts.push(i);
    const yMax = Math.max(r.inv, ...KEYS.map(k => Math.max(...Array.from(r.value[k])))) * (log ? 1.15 : 1.04);
    // 对数坐标：下限取三条线一开始的最小值再放低一点，这样 2000 年那段跌多少看得出来
    const yMin = log ? Math.min(r.invested[0], ...KEYS.map(k => Math.min(...Array.from(r.value[k])))) * 0.85 : 0;
    const plotH = H - M.t - M.b;
    const x = (d: number) => M.l + ((d - d0) / Math.max(1, d1 - d0)) * (W - M.l - M.r);
    const y = (v: number) => (log ? M.t + (1 - (Math.log10(v) - Math.log10(yMin)) / (Math.log10(yMax) - Math.log10(yMin))) * plotH : M.t + (1 - v / yMax) * plotH);

    const yTicks = log ? logTicks(yMin, yMax, plotH) : niceTicks(yMax);
    const tickLabel = log ? shortLog : short;
    const yrs: number[] = [];
    const yA = new Date(d0 * DAY).getUTCFullYear() + 1, yB = new Date(d1 * DAY).getUTCFullYear();
    // 最后一个年份刻度离右边太近就不画，免得和结束点挤在一起
    const span = yB - yA + 1;
    const stepY = span > 20 ? 5 : span > 10 ? 2 : 1;
    for (let yy = yA; yy <= yB; yy++) if ((yy - yA) % stepY === 0 && x(utcDay(yy, 1, 1)) < W - M.r - 18) yrs.push(yy);

    const path = (arr: ArrayLike<number>) => pts.map((i, k) => (k ? "L" : "M") + x(days[i]).toFixed(1) + "," + y(arr[i - r.i0]).toFixed(1)).join("");
    const labelY = KEYS.map(k => y(r.value[k][r.n - 1]));
    if (Math.abs(labelY[0] - labelY[1]) < 14) { const mid = (labelY[0] + labelY[1]) / 2, up = labelY[0] < labelY[1] ? 0 : 1; labelY[up] = mid - 7; labelY[1 - up] = mid + 7; }

    svg.setAttribute("viewBox", `0 0 ${W} ${H}`);
    svg.setAttribute("width", String(W));
    svg.setAttribute("height", String(H));
    svg.classList.toggle("is-log", log);
    svg.innerHTML =
      yTicks.map(v => `<line class="fn-grid" x1="${M.l}" x2="${W - M.r}" y1="${y(v).toFixed(1)}" y2="${y(v).toFixed(1)}"/><text x="${M.l - 8}" y="${(y(v) + 4).toFixed(1)}" text-anchor="end">${tickLabel(v)}</text>`).join("") +
      yrs.map(yy => { const xx = x(utcDay(yy, 1, 1)).toFixed(1); return `<text x="${xx}" y="${H - 8}" text-anchor="middle">${yy}</text>`; }).join("") +
      `<line class="fn-axis" x1="${M.l}" x2="${W - M.r}" y1="${(M.t + plotH).toFixed(1)}" y2="${(M.t + plotH).toFixed(1)}"/>` +
      `<path class="dca-line dca-inv" d="${path(r.invested)}"/>` +
      KEYS.map(k => `<path class="dca-line" data-k="${k}" d="${path(r.value[k])}"/>`).join("") +
      (log ? KEYS.map(k => pts.map(i => `<circle class="dca-pt" data-k="${k}" cx="${x(days[i]).toFixed(1)}" cy="${y(r.value[k][i - r.i0]).toFixed(1)}" r="2.3"/>`).join("")).join("") : "") +
      KEYS.map((k, i) => `<text class="dca-lab" data-k="${k}" x="${(W - M.r + 6).toFixed(1)}" y="${(labelY[i] + 4).toFixed(1)}">${k}</text>`).join("") +
      `<line class="fn-rule" y1="${M.t}" y2="${H - M.b}"/>` +
      KEYS.map(k => `<circle class="fn-dot" data-k="${k}" r="4"/>`).join("") +
      `<circle class="fn-dot dca-dot-inv" r="3"/>`;

    // 十字线 + 提示框：按横坐标找最近的交易日，三条线的值一起显示
    const tip = root.querySelector<HTMLElement>(".fn-tip")!;
    const rule = svg.querySelector<SVGLineElement>(".fn-rule")!;
    const dots = KEYS.map(k => svg.querySelector<SVGCircleElement>(`.fn-dot[data-k="${k}"]`)!);
    const dotInv = svg.querySelector<SVGCircleElement>(".dca-dot-inv")!;
    const show = (e: PointerEvent) => {
      const rect = svg.getBoundingClientRect();
      const px = ((e.clientX - rect.left) / rect.width) * W;
      const d = d0 + ((px - M.l) / (W - M.l - M.r)) * (d1 - d0);
      // 最近的一个点：对数模式只在取样的点之间挑，和画出来的点对得上
      let i = lowerBound(days, Math.round(d));
      i = Math.min(r.endIdx, Math.max(r.i0, i));
      if (i > r.i0 && Math.abs(days[i - 1] - d) < Math.abs(days[i] - d)) i--;
      if (log) i = pts.reduce((best, p) => (Math.abs(days[p] - d) < Math.abs(days[best] - d) ? p : best), pts[0]);
      const j = i - r.i0;
      const xx = x(days[i]);
      rule.setAttribute("x1", String(xx)); rule.setAttribute("x2", String(xx));
      KEYS.forEach((k, n) => { dots[n].setAttribute("cx", String(xx)); dots[n].setAttribute("cy", String(y(r.value[k][j]))); });
      dotInv.setAttribute("cx", String(xx)); dotInv.setAttribute("cy", String(y(r.invested[j])));
      svg.classList.add("is-hover");
      tip.replaceChildren();
      const h = document.createElement("p"); h.className = "fn-tip-h"; h.textContent = iso(days[i]); tip.append(h);
      const row = (cls: string, label: string, v: string) => {
        const p = document.createElement("p"); p.className = "fn-tip-r";
        const key = document.createElement("i"); key.className = cls;
        const b = document.createElement("b"); b.textContent = v;
        p.append(key, document.createTextNode(label), b); tip.append(p);
      };
      row("dca-key-inv", s.invested, money(r.invested[j]));
      KEYS.forEach(k => row(`dca-key-${k}`, k === "IVV" ? s.ivv : s.qqq, money(r.value[k][j]) + (r.invested[j] ? "  ×" + (r.value[k][j] / r.invested[j]).toFixed(2) : "")));
      tip.hidden = false;
      const left = (xx / W) * rect.width;
      const tw = tip.offsetWidth;
      tip.style.left = `${left + 14 + tw > rect.width ? left - 14 - tw : left + 14}px`;
      tip.style.top = `${Math.max(0, ((e.clientY - rect.top) / rect.height) * H - 30)}px`;
    };
    const hide = () => { svg.classList.remove("is-hover"); tip.hidden = true; };
    svg.onpointermove = show; svg.onpointerdown = show; svg.onpointerleave = hide;
  }

  function fillStats(root: HTMLElement, r: Result | null, s: Strings, y0: number, m0: number, y1: number, m1: number) {
    const inEl = root.querySelector<HTMLElement>(".dca-in")!;
    const inN = root.querySelector<HTMLElement>(".dca-in-n")!;
    if (!r) {
      inEl.textContent = "—"; inN.textContent = " ";
      KEYS.forEach(k => { const st = root.querySelector<HTMLElement>(`.dca-stat[data-k="${k}"]`)!; st.querySelector(".dca-v")!.textContent = "—"; st.querySelector(".bx-hero-n")!.textContent = " "; });
      return;
    }
    inEl.textContent = money(r.inv);
    inN.textContent = `${tplStr(s.monthsCount, { n: r.buys })} · ${y0}-${String(m0).padStart(2, "0")}→${y1}-${String(m1).padStart(2, "0")}`;
    KEYS.forEach(k => {
      const st = root.querySelector<HTMLElement>(`.dca-stat[data-k="${k}"]`)!;
      const { value, mult, irr } = r.stats[k];
      st.querySelector(".dca-v")!.textContent = money(value);
      st.querySelector(".bx-hero-n")!.textContent = `${tplStr(s.multiple, { x: mult.toFixed(2) })} · ${tplStr(s.annual, { r: isFinite(irr) ? (irr * 100).toFixed(1) + "%" : "—" })}`;
    });
  }

  async function setup() {
    for (const root of document.querySelectorAll<HTMLElement>(".dca")) {
      if (root.dataset.ready) continue;
      root.dataset.ready = "1";
      const s = JSON.parse(root.querySelector(".dca-strings")!.textContent!) as Strings;
      const data = (await (await fetch(root.dataset.src!)).json()) as Data;
      const last = new Date(data.days[data.days.length - 1] * DAY);
      const Y1 = last.getUTCFullYear(), M1 = last.getUTCMonth() + 1;
      const q = <T extends Element>(c: string) => root.querySelector<T>(c)!;
      const y0 = q<HTMLSelectElement>(".dca-y0"), m0 = q<HTMLSelectElement>(".dca-m0"), y1 = q<HTMLSelectElement>(".dca-y1"), m1 = q<HTMLSelectElement>(".dca-m1");
      const dd = q<HTMLSelectElement>(".dca-d"), amt = q<HTMLInputElement>(".dca-a");
      const svg = q<SVGSVGElement>(".dca-chart svg");
      // 开始日期不能早于数据的第一天（IVV 的第一个交易日）：同一年里更早的月份、同一月里更早的日子都不给选，
      // 免得看起来像 1 月就有 IVV 了
      const f = new Date(data.days[0] * DAY);
      const fy = f.getUTCFullYear(), fm = f.getUTCMonth() + 1, fd = f.getUTCDate();
      const limit = () => {
        for (const o of m0.options) o.disabled = +y0.value === fy && +o.value < fm;
        if (m0.selectedOptions[0]?.disabled) m0.value = String(fm);
        for (const o of dd.options) o.disabled = +y0.value === fy && +m0.value === fm && +o.value < fd;
        if (dd.selectedOptions[0]?.disabled) dd.value = String(fd);
      };
      const curBtns = Array.from(root.querySelectorAll<HTMLButtonElement>(".dca-cur button"));
      const symEl = q<HTMLElement>(".dca-amt i");
      const defAmt = () => (root.dataset.cur === "cny" ? 3000 : 500);
      const run = () => {
        limit();
        SYM = root.dataset.cur === "cny" ? "¥" : "$";
        symEl.textContent = SYM;
        let a = +y0.value, b = +m0.value, c = +y1.value, d = +m1.value;
        if (c < a || (c === a && d < b)) { c = a; d = b; y1.value = String(c); m1.value = String(d); }
        const money = Math.max(1, Math.round(+amt.value || 0));
        const r = compute(data, a, b, c, d, +dd.value, money);
        fillStats(root, r, s, a, b, c, d);
        if (r) draw(root, data, r, s); else svg.innerHTML = "";
      };
      [y0, m0, y1, m1, dd].forEach(el => el.addEventListener("change", run));
      const logBtn = q<HTMLButtonElement>(".dca-log");
      logBtn.addEventListener("click", () => {
        const on = root.dataset.log !== "1";
        root.dataset.log = on ? "1" : "0";
        logBtn.setAttribute("aria-pressed", String(on));
        run();
      });
      amt.addEventListener("input", run);
      // 重置：回到默认的 2000 年 6 月到数据最后一个月、每月 1 号、每月 500 美元（人民币模式下 3000 元）
      q<HTMLButtonElement>(".dca-reset").addEventListener("click", () => {
        y0.value = "2000"; m0.value = "6"; y1.value = String(Y1); m1.value = String(M1); dd.value = "1"; amt.value = String(defAmt());
        run();
      });
      // 切换货币：默认金额换成 500 美元 / 3000 元，所有数字前的符号跟着换
      curBtns.forEach(btn => btn.addEventListener("click", () => {
        root.dataset.cur = btn.dataset.cur;
        curBtns.forEach(b => b.setAttribute("aria-pressed", String(b === btn)));
        amt.value = String(defAmt());
        run();
      }));
      run();
      let lastW = svg.parentElement!.clientWidth;
      new ResizeObserver(() => { const w = Math.round(svg.parentElement!.clientWidth); if (w && w !== lastW) { lastW = w; run(); } }).observe(svg.parentElement!);
    }
  }
  document.addEventListener("astro:page-load", setup);
</script>

<style is:global>
  .dca {
    --c-ivv: #016dac;
    --c-qqq: #c2353c;
    --c-inv: #8a8680;
  }
  [data-theme="dark"] .dca {
    --c-ivv: #5595c8;
    --c-qqq: #e06a6a;
    --c-inv: #9c988f;
  }
  .dca .bx-controls {
    margin-bottom: 18px;
  }
  .dca .bx-range select {
    padding-right: 6px;
  }
  .dca-amt {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--card);
    color: var(--foreground);
  }
  .dca-amt i {
    padding-left: 8px;
    font-style: normal;
    font-size: 13px;
    color: var(--faint);
  }
