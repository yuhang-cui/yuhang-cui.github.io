---
import type { CollectionEntry } from "astro:content";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import config from "@/config";

dayjs.extend(utc);
dayjs.extend(timezone);

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;

const {
  title,
  description,
  tags,
  pubDatetime,
  timezone: postTimezone,
  stat,
  statLabel,
} = data;

// 第一个标签当作文章分类，显示在标题上方
const category = tags[0];
const date = dayjs(pubDatetime)
  .tz(postTimezone ?? config.site.timezone)
  .format("YYYY-MM-DD");
---

<li class="post-item">
  <a
    href={getPostUrl(id, filePath, Astro.currentLocale)}
    class:list={["post-link group", { "post-link--stat": stat }]}
  >
    <div>
      <p class="post-meta">
        {category && <span class="post-meta-cat">{category}</span>}
        {category && <span aria-hidden="true"> · </span>}
        <time datetime={dayjs(pubDatetime).toISOString()}>{date}</time>
      </p>
      <Heading
        transition:name={toTransitionName(id)}
        class="text-foreground group-hover:text-accent mt-2 text-lg leading-snug font-semibold transition-colors sm:text-xl"
      >
        {title}
      </Heading>
      <p class="post-card-summary mt-1.5 line-clamp-2 text-[15px] leading-relaxed">
        {description}
      </p>
    </div>
    {
      stat && (
        <div class="post-stat">
          <span class="post-stat-num">{stat}</span>
          {statLabel && <span class="post-stat-label">{statLabel}</span>}
        </div>
      )
    }
  </a>
</li>
