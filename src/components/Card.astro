---
import type { CollectionEntry } from "astro:content";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import { categoryColorClass } from "@/utils/categories";
import { slugifyStr } from "@/utils/slugify";
import config from "@/config";

dayjs.extend(utc);
dayjs.extend(timezone);

type Props = {
  variant?: "h2" | "h3";
  /** 同一页出现两次的文章（精选里也在最新里），只给一处加过渡动画名，否则浏览器报重复 */
  noTransition?: boolean;
  /** 首页“精选”里用：做成浅底色卡片 */
  boxed?: boolean;
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, data, filePath, noTransition = false, boxed = false } = Astro.props;

const {
  title,
  description,
  tags,
  pubDatetime,
  timezone: postTimezone,
  stat,
  statLabel,
} = data;

// 第一个标签就是文章分类，显示在标题下方
const category = tags[0];
const date = dayjs(pubDatetime)
  .tz(postTimezone ?? config.site.timezone)
  .format("YYYY-MM-DD");
---

<li class:list={["post-item", { "post-item--card": boxed }]}>
  <a
    href={getPostUrl(id, filePath, Astro.currentLocale)}
    class:list={["post-link group", { "post-link--stat": stat }]}
  >
    <div>
      <Heading
        transition:name={noTransition ? undefined : toTransitionName(id)}
        class="text-foreground group-hover:text-accent text-lg leading-snug font-semibold transition-colors sm:text-xl"
      >
        {title}
      </Heading>
      <p class="post-meta mt-2">
        {category && <span class:list={["tag-pill", categoryColorClass(slugifyStr(category))]}>{category}</span>}
        <time datetime={dayjs(pubDatetime).toISOString()}>{date}</time>
      </p>
      <p class="post-card-summary mt-1.5 line-clamp-2 text-[15px] leading-relaxed">
        {description}
      </p>
    </div>
    {
      stat && (
        <div class="post-stat">
          <span class="post-stat-num">{stat}</span>
          {statLabel && <span class="post-stat-label">{statLabel}</span>}
        </div>
      )
    }
  </a>
</li>
