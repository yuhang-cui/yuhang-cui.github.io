---
// 突破统计的可交互卡片。两篇文章共用：defaultRef 决定打开时停在哪个视图，顶部可以切换。
// inst="gc" 是黄金的卡片：按钮换成“全天 / 只看纽约时段”，多一块“第一次突破出在哪个时段”，底下和 ES 对比。
// 中英文共用：界面文字按页面语言取，和数据一起交给浏览器端脚本。
import es from "@/data/breakout-by-year.json";
import gc from "@/data/breakout-gold.json";
import { renderBreakout, years, type ByYear, type BreakoutOpt, type Ref } from "@/utils/breakoutView";
import { useTranslations } from "@/i18n";

type Props = { defaultRef: Ref; inst?: "es" | "gc" };
const { defaultRef, inst = "es" } = Astro.props;

const s = useTranslations(Astro.currentLocale).breakout;
const gold = inst === "gc";
const refs: Exclude<Ref, "esFull">[] = gold ? ["gcDay", "gcNy"] : ["prev", "globex"];   // 顶上的两个按钮
// 底下对比的几行。黄金卡片把口径相同的放在一起：全天对全天，纽约时段对 ES 日盘
const opt: BreakoutOpt = gold ? { cmp: ["gcDay", "esFull", "gcNy", "prev"], first: gc.first } : { cmp: refs };
const all = { ...es, gcDay: gc.gcDay, gcNy: gc.gcNy, esFull: gc.esFull } as ByYear;
const d = Object.fromEntries(opt.cmp!.map(r => [r, all[r]])) as ByYear;   // 只带这张卡片用得到的几组数
const ys = years(d, defaultRef);
const y0 = ys[0];
const y1 = ys[ys.length - 1];
---

<section class="bx" data-ref={defaultRef} data-y0={y0} data-y1={y1} aria-label={s.label}>
  <div class="bx-controls">
    <div class="bx-switch" role="group" aria-label={s.refGroup}>
      {
        refs.map(r => (
          <button type="button" data-ref={r} aria-pressed={r === defaultRef ? "true" : "false"}>
            {s[r]}
          </button>
        ))
      }
    </div>
    <label class="bx-range">
      <select class="bx-y0" aria-label={s.fromYear}>
        {ys.map(y => <option value={y} selected={y === y0}>{y}</option>)}
      </select>
      <span>–</span>
      <select class="bx-y1" aria-label={s.toYear}>
        {ys.map(y => <option value={y} selected={y === y1}>{y}</option>)}
      </select>
    </label>
    <button type="button" class="bx-reset">{s.allYears}</button>
  </div>

  <div class="bx-view" set:html={renderBreakout(d, s, defaultRef, y0, y1, opt)} />

  <script type="application/json" class="bx-data" set:html={JSON.stringify({ data: d, s, opt })} />
</section>

<script>
  import { renderBreakout, type ByYear, type BreakoutOpt, type BreakoutStrings, type Ref } from "@/utils/breakoutView";

  function setup() {
    document.querySelectorAll<HTMLElement>(".bx[data-ref]").forEach(root => {
      if (root.dataset.ready) return;
      root.dataset.ready = "1";
      const { data, s, opt }: { data: ByYear; s: BreakoutStrings; opt: BreakoutOpt } = JSON.parse(
        root.querySelector(".bx-data")!.textContent!
      );
      const view = root.querySelector<HTMLElement>(".bx-view")!;
      const s0 = root.querySelector<HTMLSelectElement>(".bx-y0")!;
      const s1 = root.querySelector<HTMLSelectElement>(".bx-y1")!;
      const first = +root.dataset.y0!;
      const last = +root.dataset.y1!;
      let ref = root.dataset.ref as Ref;

      const draw = () => {
        let a = +s0.value;
        let b = +s1.value;
        if (a > b) [a, b] = [b, a];
        view.innerHTML = renderBreakout(data, s, ref, a, b, opt);
        root.querySelectorAll<HTMLButtonElement>(".bx-switch button").forEach(btn =>
          btn.setAttribute("aria-pressed", String(btn.dataset.ref === ref))
        );
      };

      root.addEventListener("click", e => {
        const t = e.target as HTMLElement;
        const sw = t.closest<HTMLButtonElement>(".bx-switch button");
        if (sw) {
          ref = sw.dataset.ref as Ref;
          return draw();
        }
        const yr = t.closest<HTMLElement>(".bx-year");
        if (yr) {
          s0.value = s1.value = yr.dataset.year!;
          return draw();
        }
        if (t.closest(".bx-reset")) {
          s0.value = String(first);
          s1.value = String(last);
          draw();
        }
      });
      s0.addEventListener("change", draw);
      s1.addEventListener("change", draw);
    });
  }

  document.addEventListener("astro:page-load", setup);
</script>
