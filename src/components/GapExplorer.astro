---
// 缺口回补：周线 / 日线、缺口方向、年份都可以切换；鼠标移到柱子或曲线上看具体数字。
import data from "@/data/gap-close.json";
import { renderGap, years, type GapData } from "@/utils/gapView";
import { useTranslations } from "@/i18n";
import { tplStr } from "@/i18n/format";

const t = useTranslations(Astro.currentLocale);
const s = t.gap;
const b = t.breakout;
const d = data as GapData;
const ys = years(d);
const y0 = ys[0];
const y1 = ys[ys.length - 1];
const c = { yearRange: b.yearRange, singleYear: b.singleYear, thousands: b.thousands };
---

<section class="bx zx gx" data-y0={y0} data-y1={y1} aria-label={s.label}>
  <div class="bx-controls">
    <div class="bx-switch" role="group" aria-label={s.periodGroup} data-k="p">
      <button type="button" data-v="w" aria-pressed="true">{s.week}</button>
      <button type="button" data-v="d" aria-pressed="false">{s.day}</button>
    </div>
    <div class="bx-switch" role="group" aria-label={s.dirGroup} data-k="dir">
      <button type="button" data-v="all" aria-pressed="true">{s.all}</button>
      <button type="button" data-v="u" aria-pressed="false">{s.up}</button>
      <button type="button" data-v="d" aria-pressed="false">{s.down}</button>
    </div>
    <label class="bx-range">
      <select class="bx-y0" aria-label={b.fromYear}>
        {ys.map(y => <option value={y} selected={y === y0}>{y}</option>)}
      </select>
      <span>–</span>
      <select class="bx-y1" aria-label={b.toYear}>
        {ys.map(y => <option value={y} selected={y === y1}>{y}</option>)}
      </select>
    </label>
    <button type="button" class="bx-reset">{b.allYears}</button>
  </div>

  <div class="gx-view" set:html={renderGap(d, s, c, tplStr(b.yearRange, { a: y0, b: y1 }), "w", "all", y0, y1, 640)} />

  <script type="application/json" class="gx-data" set:html={JSON.stringify({ data: d, s, c })} />
</section>

<script>
  import { tplStr } from "@/i18n/format";
  import { groupNum } from "@/utils/breakoutView";
  import { mount, bindHover, placeTip, svgX, rangeLabel, pc1, share } from "@/utils/chartKit";
  import {
    renderGap,
    pool,
    band,
    bucketLabel,
    tx,
    ty,
    len,
    timeOf,
    SB,
    TB,
    type GapData,
    type GapStrings,
    type GapText,
  } from "@/utils/gapView";

  type Payload = { data: GapData; s: GapStrings; c: GapText };

  function setup() {
    document.querySelectorAll<HTMLElement>(".gx").forEach(root => {
      if (root.dataset.ready) return;
      root.dataset.ready = "1";
      const { data, s, c }: Payload = JSON.parse(root.querySelector(".gx-data")!.textContent!);
      const view = root.querySelector<HTMLElement>(".gx-view")!;

      mount(root, view, ({ y0, y1, opt }, w) => {
        const { p, dir } = opt;
        view.innerHTML = renderGap(data, s, c, rangeLabel(c, y0, y1), p, dir, y0, y1, w);
        const st = pool(data, p, dir, y0, y1);
        const W = p === "w";

        // 柱状图：指针在哪一档就高亮那一档
        const sb = view.querySelector<HTMLElement>(".gx-size-box")!;
        const ssvg = sb.querySelector("svg")!;
        const stip = sb.querySelector<HTMLElement>(".fn-tip")!;
        const cols = ssvg.querySelectorAll<SVGGElement>(".gx-col");
        bindHover(
          sb,
          e => {
            const x = svgX(ssvg, w, e);
            const i = Math.floor((x - SB.l) / band(w));
            if (i < 0 || i >= st.n.length) return false;
            cols.forEach(g => g.classList.toggle("is-hover", +g.dataset.i! === i));
            const n = st.n[i];
            stip.innerHTML =
              `<p class="fn-tip-h">${tplStr(s.bucket, { a: bucketLabel(i) })} · ${tplStr(s.gaps, { n: groupNum(n, c.thousands) })}</p>` +
              `<p class="fn-tip-r"><i class="gx-key-later"></i>${W ? s.closedW : s.closedD}<b>${pc1(share(st.c[i], n))}</b></p>` +
              `<p class="fn-tip-r"><i class="gx-key-first"></i>${W ? s.firstW : s.firstD}<b>${pc1(share(st.f[i], n))}</b></p>` +
              `<p class="fn-tip-r"><i class="gx-key-open"></i>${s.openLeft}<b>${pc1(share(n - st.c[i], n))}</b></p>` +
              (n < 20 ? `<p class="fn-tip-h gx-thin">${s.thin}</p>` : "");
            placeTip(stip, ssvg, SB.l + (i + 0.5) * band(w), w, e);
          },
          () => {
            stip.hidden = true;
            cols.forEach(g => g.classList.remove("is-hover"));
          }
        );

        // 累计曲线：指针在哪个时间，就显示到那时为止碰回了多少
        const tb = view.querySelector<HTMLElement>(".gx-time-box")!;
        const tsvg = tb.querySelector("svg")!;
        const ttip = tb.querySelector<HTMLElement>(".fn-tip")!;
        const rule = tsvg.querySelector<SVGLineElement>(".fn-rule")!;
        const dot = tsvg.querySelector<SVGCircleElement>(".gx-dot")!;
        bindHover(
          tb,
          e => {
            const x = svgX(tsvg, w, e);
            const k = Math.round(((x - TB.l) / (w - TB.l - TB.r)) * len(p));
            if (k < 1 || k > len(p)) return false;
            const v = share(st.cum[k], st.total) || 0;
            rule.setAttribute("x1", String(tx(k, p, w)));
            rule.setAttribute("x2", String(tx(k, p, w)));
            dot.setAttribute("cx", String(tx(k, p, w)));
            dot.setAttribute("cy", String(ty(v)));
            tsvg.classList.add("is-hover");
            ttip.innerHTML =
              `<p class="fn-tip-h">${tplStr(s.by, { t: timeOf(s, p, k) })}</p>` +
              `<p class="fn-tip-r">${s.cumTip}<b>${pc1(v)}</b></p>`;
            placeTip(ttip, tsvg, tx(k, p, w), w, e);
          },
          () => {
            tsvg.classList.remove("is-hover");
            ttip.hidden = true;
          }
        );
      });
    });
  }

  document.addEventListener("astro:page-load", setup);
</script>
