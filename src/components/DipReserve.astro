  }
  .dr-stat .bx-hero-k {
    display: flex;
    align-items: center;
    gap: 7px;
  }
  .dr-stat .bx-hero-k i {
    display: inline-block;
    width: 14px;
    height: 3px;
    border-radius: 2px;
  }
  .dr-stat.is-plain .bx-hero-k i { background: var(--dr-plain); }
  .dr-stat.is-strat .bx-hero-k i { background: var(--dr-strat); }
  .dr-v {
    margin-top: 2px !important;
    font-size: 24px;
