    letter-spacing: -0.01em;
    color: var(--foreground);
  }
  .dr-stat.is-big .dr-v {
    font-size: 40px;
    line-height: 1.05;
  }
  .dr-line {
    fill: none;
    stroke-width: 1.8;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .dr-line.is-strat { stroke: var(--dr-strat); }
  .dr-line.is-plain { stroke: var(--dr-plain); }
  .dr-line.is-inv { stroke: var(--dr-inv); stroke-width: 1.5; stroke-dasharray: 4 4; }
  .dr-line.is-gap { stroke: var(--dr-strat); stroke-width: 1.5; }
  .fn-chart text.dr-end { font-size: 12px; font-weight: 600; }
  .fn-chart text.dr-end.is-plain { fill: var(--dr-plain); }
  .fn-chart text.dr-end.is-strat { fill: var(--dr-strat); }
  .dr-area { fill: var(--dr-strat); opacity: 0.12; }
  .dr-mark { fill: var(--dr-strat); stroke: var(--card); stroke-width: 2; }
  .fn-chart text.dr-lab { fill: var(--foreground); font-size: 12px; font-weight: 600; }
  .fn-chart text.dr-thr-t { fill: var(--dr-strat); font-size: 11px; }
  .fn-chart text.dr-cap { fill: var(--summary); font-size: 11.5px; }
  .dr .fn-dot { stroke: var(--card); stroke-width: 2; }
  .dr-dot.is-strat { fill: var(--dr-strat); }
  .dr-dot.is-plain { fill: var(--dr-plain); }
  .dr-dot.is-gap { fill: var(--dr-strat); }
  .dr-tiles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 20px;
  }
  .dr-tile {
    padding: 12px 0 14px;
    border-top: 1px solid var(--border);
  }
  .dr-fwd-h {
    margin-bottom: 10px !important;
  }
  .dr-rows {
    display: grid;
    gap: 9px;
  }
  .dr-row {
    display: grid;
    grid-template-columns: 9.5em minmax(0, 1fr) 4em 5.5em;
