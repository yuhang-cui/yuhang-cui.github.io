---
import type { HTMLAttributes } from "astro/types";
import { useTranslations } from "@/i18n";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const currentYear = new Date().getFullYear();
const t = useTranslations(Astro.currentLocale);
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div
    class="border-border flex flex-wrap items-center justify-between gap-x-6 gap-y-1 border-t py-6 text-[13px]"
    style="color: var(--faint)"
  >
    <span>&#169; {currentYear} {t.site.author}</span>
  </div>
</footer>
