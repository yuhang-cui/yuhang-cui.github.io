---
// 竖向年表：一条线从上到下，年份在线左边，事件在线右边，按时间顺序读。
// rows 是几个时代，每个时代的名字作为小标题插在线旁边；big 的事件用实心主题色点并加粗。
type Item = { year: string; text: string; big?: boolean };
type Row = { label: string; items: Item[] };
type Props = { rows: Row[]; caption?: string };
const { rows, caption } = Astro.props;
---

<figure class="tl">
  <ol class="tl-list">
    {
      rows.map(r => (
        <>
          <li class="tl-era">
            <span class="tl-era-text">{r.label}</span>
          </li>
          {r.items.map(it => (
            <li class:list={["tl-item", it.big && "is-big"]}>
              <span class="tl-year">{it.year}</span>
              <span class="tl-dot" aria-hidden="true" />
              <span class="tl-text">{it.text}</span>
            </li>
          ))}
        </>
      ))
    }
  </ol>
  {caption && <figcaption class="fn-note">{caption}</figcaption>}
</figure>

<style>
  .tl {
    margin: 0.5rem 0 0;
  }
  .tl-list {
    position: relative;
    margin: 0 !important;
    padding: 0 !important;
    list-style: none;
  }
  /* 竖线：穿过所有点的中心 */
  .tl-list::before {
    content: "";
    position: absolute;
    top: 10px;
    bottom: 10px;
    left: calc(56px + 11px);
    border-left: 2px solid var(--border);
  }
  .tl-era,
  .tl-item {
    position: relative;
    display: grid;
    grid-template-columns: 56px 24px 1fr;
    column-gap: 10px;
    align-items: baseline;
    margin: 0 !important;
    padding: 0 !important;
  }
  .tl-era {
    margin-top: 14px !important;
    padding-bottom: 4px !important;
  }
  .tl-list > .tl-era:first-child {
    margin-top: 0 !important;
  }
  .tl-era-text {
    grid-column: 3;
    font-size: 14.5px;
    font-weight: 700;
    color: var(--foreground);
  }
  .tl-item {
    padding: 5px 0 !important;
  }
  .tl-year {
    text-align: right;
    font-size: 12.5px;
    color: var(--summary);
    font-variant-numeric: tabular-nums;
  }
  .tl-dot {
    position: relative;
    top: -1px;
    justify-self: center;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--card);
    border: 2px solid var(--summary);
  }
  .tl-text {
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--prose);
  }
  .tl-item.is-big .tl-year {
    color: var(--accent);
    font-weight: 700;
  }
  .tl-item.is-big .tl-dot {
    width: 14px;
    height: 14px;
    top: 0;
    background: var(--accent);
    border-color: var(--accent);
  }
  .tl-item.is-big .tl-text {
    font-weight: 600;
    color: var(--foreground);
  }
  @media (max-width: 520px) {
    .tl-era,
    .tl-item {
      grid-template-columns: 40px 20px 1fr;
      column-gap: 8px;
    }
    .tl-list::before {
      left: calc(40px + 8px + 9px);
    }
    .tl-year,
    .tl-text {
      font-size: 12.5px;
    }
  }
</style>
