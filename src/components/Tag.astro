---
import { getRelativeLocaleUrl } from "astro:i18n";
import { tagColorClass } from "@/utils/tagColor";
import config from "@/config";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
};

const { tag, tagName, size = "lg" } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
---

<li>
  <a
    href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}
    transition:name={tag}
    class:list={[
      "tag-pill hover:opacity-75 focus-visible:opacity-75",
      tagColorClass(tag),
      { "text-[12px]!": size === "lg" },
    ]}
  >
    {tagName}
  </a>
</li>
