---
// 表格卡片：几张相关的表放进一张卡片，用标签页切换，文章不会拉得太长。
// 外观沿用研究卡片（.rc）。内容里每张表包一层 <div class="tt-panel">，顺序和 tabs 一一对应。
import { useTranslations } from "@/i18n";

type Props = {
  title: string;
  tabs: string[];
};
const { title, tabs } = Astro.props;
const t = useTranslations(Astro.currentLocale);
---

<section class="rc tt" aria-label={title} data-pin={t.tableCard.pin} data-unpin={t.tableCard.unpin}>
  <div class="rc-head">
    <p class="rc-title">{title}</p>
    <div class="tt-tools">
      <div class="rc-tabs" role="tablist">
        {tabs.map((label, i) => (
          <button type="button" role="tab" aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>{label}</button>
        ))}
      </div>
      <button type="button" class="tt-pin" aria-pressed="false" aria-label={t.tableCard.pin} title={t.tableCard.pinHint}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M15.4 2.6a1 1 0 0 1 1.4 0l4.6 4.6a1 1 0 0 1 0 1.4l-1.5 1.5a1 1 0 0 1-1.1.2l-1.4-.6-3.3 3.3.4 3.1a1 1 0 0 1-.3.8l-1.4 1.4a1 1 0 0 1-1.4 0L8 15.4l-4.3 4.3a1 1 0 1 1-1.4-1.4L6.6 14l-3.3-3.3a1 1 0 0 1 0-1.4l1.4-1.4a1 1 0 0 1 .8-.3l3.1.4 3.3-3.3-.6-1.4a1 1 0 0 1 .2-1.1l1.5-1.5z"/></svg>
      </button>
    </div>
  </div>
  <div class="rc-panel tt-body">
    <slot />
  </div>
</section>

<script>
  // 一开始只显示第一张（脚本跑之前由 CSS 先藏好其余几张）
  document.querySelectorAll<HTMLElement>(".tt").forEach(card => {
    card.querySelectorAll<HTMLElement>(".tt-panel").forEach((p, j) => (p.hidden = j !== 0));
    card.dataset.ready = "";
  });

  // 点标签：只显示对应的那张表
  document.addEventListener("click", e => {
    const tab = (e.target as HTMLElement).closest<HTMLButtonElement>(".tt [role=tab]");
    if (!tab) return;
    const card = tab.closest(".tt")!;
    const tabs = Array.from(card.querySelectorAll<HTMLButtonElement>("[role=tab]"));
    const panels = card.querySelectorAll<HTMLElement>(".tt-panel");
    const i = tabs.indexOf(tab);
    tabs.forEach((b, j) => {
      b.setAttribute("aria-selected", String(j === i));
      b.tabIndex = j === i ? 0 : -1;
    });
    panels.forEach((p, j) => (p.hidden = j !== i));
  });

  // 图钉：点一下，这张表卡片固定在页头下方（position: sticky），往下读结论时可以对照；再点一下取消。
  // 同一时间只固定一张；按 Esc 也能取消。
  const syncPinTop = () => {
    const header = document.querySelector<HTMLElement>("header");
    const h = header && getComputedStyle(header).position === "sticky" ? header.getBoundingClientRect().height : 0;
    document.documentElement.style.setProperty("--tt-pin-top", `${Math.round(h) + 8}px`);
  };
  const setPinned = (card: HTMLElement, on: boolean) => {
    card.dataset.pinned = on ? "true" : "false";
    const btn = card.querySelector<HTMLButtonElement>(".tt-pin");
    if (btn) {
      btn.setAttribute("aria-pressed", String(on));
      btn.setAttribute("aria-label", (on ? card.dataset.unpin : card.dataset.pin)!);
    }
  };
  document.addEventListener("click", e => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(".tt-pin");
    if (!btn) return;
    const card = btn.closest<HTMLElement>(".tt")!;
    const on = card.dataset.pinned !== "true";
    if (on) {
      syncPinTop();
      document.querySelectorAll<HTMLElement>(".tt[data-pinned=true]").forEach(c => setPinned(c, false));
    }
    setPinned(card, on);
  });
  document.addEventListener("keydown", e => {
    if (e.key !== "Escape") return;
    document.querySelectorAll<HTMLElement>(".tt[data-pinned=true]").forEach(c => setPinned(c, false));
  });
  window.addEventListener("resize", syncPinTop);
  syncPinTop();

  // 左右方向键在标签之间切换
  document.addEventListener("keydown", e => {
    const tab = (e.target as HTMLElement).closest<HTMLButtonElement>(".tt [role=tab]");
    if (!tab || (e.key !== "ArrowRight" && e.key !== "ArrowLeft")) return;
    const tabs = Array.from(tab.parentElement!.querySelectorAll<HTMLButtonElement>("[role=tab]"));
    const next = tabs[(tabs.indexOf(tab) + (e.key === "ArrowRight" ? 1 : tabs.length - 1)) % tabs.length];
    next.focus();
    next.click();
  });
</script>
