---
// K 线收线提醒：每根 K 线收线前响一下（默认 5 分钟图、提前 1 分钟，只在所选市场的交易时段响）。
// 时钟上方选市场：美东 ES、北京股指期货、德国 DAX、东京日经 225、伦敦富时 100，时间和时段都按当地时间。
// 可以单独关掉接下来某几根，或者静音一段时间。设置和“哪几根不响”存在本机浏览器里。
// 声音用 Web Audio 按音频时钟提前排好，后台标签页里计时器被浏览器放慢也能准时响。
import { useTranslations } from "@/i18n";

const s = useTranslations(Astro.currentLocale).barAlarm;
// 市场的顺序和 s.zones 的名字一一对应（具体时区和时段写在下面的脚本里）
const MARKETS = ["us", "cn", "de", "jp", "uk"];
---

<section class="bx ba" aria-label={s.label} data-s={JSON.stringify(s)}>
  <div class="ba-top">
    <div>
      <select class="bx-hero-k ba-zone" name="market" aria-label={s.zone}>
        {MARKETS.map((m, i) => <option value={m}>{s.zones[i]}</option>)}
      </select>
      <p class="ba-clock" aria-live="off">--:--:--</p>
    </div>
    <div class="ba-actions">
      <button type="button" class="ba-gear" aria-expanded="false" aria-controls="ba-settings" aria-label={s.settings} title={s.settings}>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
      </button>
      <button type="button" class="ba-run" aria-pressed="false">{s.start}</button>
    </div>
  </div>

  <div class="ba-settings" id="ba-settings" hidden>
    <div class="ba-grid">
      <label>{s.tf}
        <select name="tf">
          {[1, 2, 3, 5, 10, 15].map(m => <option value={m} selected={m === 5}>{m} {s.min}</option>)}
        </select>
      </label>
      <label>{s.lead}
        <select name="lead">
          {[15, 30, 60, 90, 120].map(v => <option value={v} selected={v === 60}>{v < 60 ? `${v} ${s.sec}` : `${v / 60} ${s.min}`}</option>)}
        </select>
      </label>
      <div class="ba-sess"></div>
      <label>{s.volume}<input name="vol" type="range" min="0" max="1" step="0.05" value="0.6" /></label>
      <label class="ba-check"><input name="notify" type="checkbox" />{s.notify}</label>
    </div>
    <button type="button" class="bx-reset ba-test">{s.test}</button>
  </div>

  <div class="ba-status">
    <p class="ba-state">{s.stopped}</p>
    <p class="ba-next"></p>
    <div class="ba-bar"><span></span></div>
  </div>

  <div class="ba-quick" role="group" aria-label={s.quick}>
    <button type="button" data-skip="1">{s.skip1} <kbd>N</kbd></button>
    <button type="button" data-skip="2">{s.skip2}</button>
    <button type="button" data-skip="3">{s.skip3}</button>
    <button type="button" data-mute="15">{s.mute15}</button>
    <button type="button" data-mute="30">{s.mute30}</button>
    <button type="button" data-restore>{s.restore} <kbd>R</kbd></button>
  </div>

  <p class="bx-sub"><b class="ba-listday">{s.upcoming}</b><span>{s.upcomingHint}</span></p>
  <div class="ba-list"></div>


  <p class="fn-note"><span class="ba-mnote"></span>{s.note}</p>
</section>

<script>
  type S = Record<string, any>;
  type Session = [string, string]; // 当地时间的开始、结束；结束早于开始就是跨过午夜（东京夜盘）
  type Settings = { tf: number; lead: number; vol: number; notify: boolean; market: string; sessions: Record<string, Session[]> };
  type Saved = { settings: Settings; skipped: number[]; muteUntil: number; running: boolean };

  // 每个市场：当地时区 + 默认交易时段（只算周一到周五开始的时段，不含交易所假日）
  const MARKETS: Record<string, { tz: string; sessions: Session[] }> = {
    us: { tz: "America/New_York", sessions: [["09:30", "16:15"]] }, // ES / MES 日盘
    cn: { tz: "Asia/Shanghai", sessions: [["09:30", "11:30"], ["13:00", "15:00"]] }, // 中金所股指期货，中午休市
    de: { tz: "Europe/Berlin", sessions: [["09:00", "17:30"]] }, // DAX，Xetra 开盘时段
    jp: { tz: "Asia/Tokyo", sessions: [["08:45", "15:45"], ["17:00", "06:00"]] }, // 日经 225：日盘、夜盘
    uk: { tz: "Europe/London", sessions: [["08:00", "16:30"]] }, // 富时 100，伦敦交易所开盘时段
  };

  const KEY = "bar-alarm-v1";
  const DEFAULTS: Settings = { tf: 5, lead: 60, vol: 0.6, notify: false, market: "us", sessions: {} };

  // —— 本机存储：读写失败（隐私模式等）就当没有 ——
  function load(): Saved {
    try {
      const v = JSON.parse(localStorage.getItem(KEY) || "null");
      if (v) {
        const { from, to, ...rest } = v.settings || {};
        const settings: Settings = { ...DEFAULTS, ...rest, sessions: { ...rest.sessions } };
        // 旧版只存了美东日盘的 from / to
        if (from && to && !settings.sessions.us) settings.sessions.us = [[from, to]];
        if (!MARKETS[settings.market]) settings.market = DEFAULTS.market;
        return { settings, skipped: v.skipped || [], muteUntil: v.muteUntil || 0, running: !!v.running };
      }
    } catch {}
    return { settings: { ...DEFAULTS, sessions: {} }, skipped: [], muteUntil: 0, running: false };
  }
  function save(v: Saved) {
    try {
      localStorage.setItem(KEY, JSON.stringify(v));
    } catch {}
  }

  // —— 当地时间：用 Intl 换算，夏令时自动处理，本机在哪个时区都没关系 ——
  const fmts: Record<string, Intl.DateTimeFormat> = {};
  function parts(tz: string, ms: number) {
    fmts[tz] ??= new Intl.DateTimeFormat("en-US", {
      timeZone: tz,
      year: "numeric", month: "2-digit", day: "2-digit",
      hour: "2-digit", minute: "2-digit", second: "2-digit", hourCycle: "h23",
    });
    const p = Object.fromEntries(fmts[tz].formatToParts(new Date(ms)).map(x => [x.type, x.value]));
    return { y: +p.year, mo: +p.month, d: +p.day, h: +p.hour, mi: +p.minute, s: +p.second };
  }
  // 当地某天第 minutes 分钟对应的真实时刻（毫秒）；minutes 超过 1440 就是第二天
  function toMs(tz: string, y: number, mo: number, d: number, minutes: number) {
    const guess = Date.UTC(y, mo - 1, d, 0, minutes);
    const p = parts(tz, guess);
    const shown = Date.UTC(p.y, p.mo - 1, p.d, p.h, p.mi);
    return guess - (shown - guess);
  }
  const hm = (v: string) => {
    const [h, m] = v.split(":").map(Number);
    return h * 60 + m;
  };
  const pad = (n: number) => String(n).padStart(2, "0");
  let tz = MARKETS.us.tz; // 当前市场的时区，页面上的时间都按它显示
  const clock = (ms: number, sec = false) => {
    const p = parts(tz, ms);
    return `${pad(p.h)}:${pad(p.mi)}${sec ? ":" + pad(p.s) : ""}`;
  };

  type Bar = { n: number; sess: number; open: number; close: number; alarm: number; day: string; ymd: [number, number, number] };
  const GROUP_MIN = 120; // 每 2 小时一组：美东 5 分钟图正好是第 1–24、25–48、49–72 根，剩下的归最后一组

  const sessionsOf = (st: Settings) => st.sessions[st.market] || MARKETS[st.market].sessions;

  // 当地某个交易日（周一到周五）开始的全部 K 线，按时段先后排；跨午夜的时段一直算到第二天
  function barsOn(st: Settings, y: number, mo: number, d: number): Bar[] {
    const zone = MARKETS[st.market].tz;
    const out: Bar[] = [];
    sessionsOf(st).forEach(([from, to], sess) => {
      const a = hm(from);
      let b = hm(to);
      if (b <= a) b += 1440;
      const n = Math.floor((b - a) / st.tf);
      for (let i = 1; i <= n; i++) {
        const close = toMs(zone, y, mo, d, a + i * st.tf);
        out.push({ n: i, sess, open: close - st.tf * 60000, close, alarm: close - st.lead * 1000, day: `${mo}/${d}`, ymd: [y, mo, d] });
      }
    });
    return out;
  }

  // 从 now 开始往后的 count 根 K 线；从前一天开始找，凌晨还在昨晚的夜盘里也能算到
  function upcoming(st: Settings, now: number, count: number): Bar[] {
    const out: Bar[] = [];
    const p = parts(MARKETS[st.market].tz, now);
    for (let dayStep = -1; out.length < count && dayStep < 10; dayStep++) {
      const day = new Date(Date.UTC(p.y, p.mo - 1, p.d + dayStep));
      const wd = day.getUTCDay();
      if (wd === 0 || wd === 6) continue;
      for (const b of barsOn(st, day.getUTCFullYear(), day.getUTCMonth() + 1, day.getUTCDate())) {
        if (b.close > now && out.length < count) out.push(b);
      }
    }
    return out;
  }

  function setup() {
    document.querySelectorAll<HTMLElement>(".ba").forEach(root => {
      if (root.dataset.ready) return;
      root.dataset.ready = "1";
      const s: S = JSON.parse(root.dataset.s!);
      const $ = <T extends Element>(q: string) => root.querySelector<T>(q)!;
      const state = load();
      // 刷新或切回页面时沿用上次的开关：开着就接着开，声音等用户点一下页面再恢复（浏览器规定）
      let running = state.running;
      let ctx: AudioContext | null = running ? new AudioContext() : null;
      let scheduled: { at: number; nodes: AudioScheduledSourceNode[] } | null = null;
      let lastTick = Date.now();

      // 设置面板 ← 存储
      const form = $<HTMLElement>(".ba-settings");
      const field = (name: string) => form.querySelector<HTMLInputElement>(`[name=${name}]`)!;
      field("tf").value = String(state.settings.tf);
      field("lead").value = String(state.settings.lead);
      field("vol").value = String(state.settings.vol);
      field("notify").checked = state.settings.notify;
      const marketSel = $<HTMLSelectElement>(".ba-zone");

      // 交易时段的输入框：按当前市场有几段就放几对（开始、结束）
      const sessBox = $<HTMLElement>(".ba-sess");
      const sessName = (i: number) => s.sessionNames[state.settings.market][i];
      function renderSessions() {
        sessBox.innerHTML = sessionsOf(state.settings)
          .map(([a, b], i) => `<label>${s.sessFrom.replace("{{name}}", sessName(i))}<input name="from${i}" type="time" value="${a}" /></label>
            <label>${s.sessTo.replace("{{name}}", sessName(i))}<input name="to${i}" type="time" value="${b}" /></label>`)
          .join("");
      }
      function useMarket() {
        marketSel.value = state.settings.market;
        tz = MARKETS[state.settings.market].tz;
        renderSessions();
        // 下面的小字：先说这个市场的时段为什么长这样，再接通用说明
        $(".ba-mnote").textContent = s.marketNotes[state.settings.market] + " ";
      }
      useMarket();

      const isSkipped = (b: Bar) => state.skipped.includes(b.close) || b.alarm < state.muteUntil;
      const persist = () => {
        // 只留还没过去的“不响”记录
        state.skipped = state.skipped.filter(t => t > Date.now());
        save(state);
      };
      // 有两段以上的市场（午休、夜盘），K 线名字前面加上是哪一段
      const barName = (b: Bar) =>
        (sessionsOf(state.settings).length > 1 ? sessName(b.sess) + " " : "") + s.bar.replace("{{n}}", String(b.n));

      // —— 声音：两声短促的“嘀” ——
      function beepAt(when: number) {
        if (!ctx) return [];
        const nodes: AudioScheduledSourceNode[] = [];
        for (const [offset, freq] of [[0, 880], [0.22, 1175]] as const) {
          const osc = ctx.createOscillator();
          const g = ctx.createGain();
          osc.type = "sine";
          osc.frequency.value = freq;
          const t0 = when + offset;
          g.gain.setValueAtTime(0, t0);
          g.gain.linearRampToValueAtTime(state.settings.vol, t0 + 0.01);
          g.gain.exponentialRampToValueAtTime(0.0001, t0 + 0.18);
          osc.connect(g).connect(ctx.destination);
          osc.start(t0);
          osc.stop(t0 + 0.2);
          nodes.push(osc);
        }
        return nodes;
      }
      function unschedule() {
        scheduled?.nodes.forEach(n => {
          try {
            n.stop();
          } catch {}
        });
        scheduled = null;
      }
      // 把下一次要响的提醒按音频时钟排好；目标变了就重排
      function reschedule(next: Bar | undefined) {
        // 声音被浏览器挂起时音频时钟是停的，排了也不准：先撤掉，恢复后再排
        if (!running || !ctx || ctx.state !== "running" || !next) return unschedule();
        if (scheduled?.at === next.alarm) return;
        if (scheduled && scheduled.at <= Date.now()) scheduled = null; // 上一次已经在响了：让它响完，不掐断
        unschedule();
        const when = ctx.currentTime + Math.max(0, (next.alarm - Date.now()) / 1000);
        scheduled = { at: next.alarm, nodes: beepAt(when) };
      }

      function notify(b: Bar) {
        if (!state.settings.notify || !("Notification" in window) || Notification.permission !== "granted") return;
        try {
          new Notification(s.notifyTitle.replace("{{bar}}", barName(b)), {
            body: s.notifyBody.replace("{{t}}", clock(b.close)),
            silent: true,
          });
        } catch {}
      }

      // —— 画面 ——
      const list = $<HTMLElement>(".ba-list");
      const groupNames = s.groups as string[];
      let listKey = "";
      let activeGroup = "";

      // 列表：这一个交易日（今天，或收盘后 / 周末时的下一个交易日）的全部 K 线，按时段分组，只展开当前时段
      function renderDay(head: Bar, now: number, at: (ms: number) => string) {
        const st = state.settings;
        const [y, mo, d] = head.ymd;
        const bars = barsOn(st, y, mo, d);
        // 美东沿用“早盘 / 午盘 / 晚盘 / 收盘前”；其他市场每段按 2 小时再分组，名字是“日盘 2”这样
        const named = st.market === "us" && sessionsOf(st).length === 1;
        const chunkOf = (b: Bar) => {
          const first = bars.find(x => x.sess === b.sess)!;
          return Math.floor((b.open - first.open) / (GROUP_MIN * 60000));
        };
        const groupOf = (b: Bar) => (named ? `0-${Math.min(groupNames.length - 1, chunkOf(b))}` : `${b.sess}-${chunkOf(b)}`);

        // 换了一天或改了设置才重建分组，平时只更新每格的状态，展开 / 收起不会被打断
        const key = `${y}-${mo}-${d}|${st.tf}|${st.lead}|${st.market}|${JSON.stringify(sessionsOf(st))}`;
        if (key !== listKey) {
          listKey = key;
          activeGroup = "";
          const groups = new Map<string, Bar[]>();
          bars.forEach(b => {
            const g = groupOf(b);
            if (!groups.has(g)) groups.set(g, []);
            groups.get(g)!.push(b);
          });
          const keys = [...groups.keys()];
          list.innerHTML = keys
            .map((k, idx) => {
              const g = groups.get(k)!;
              const [sess, chunk] = k.split("-").map(Number);
              const many = keys.filter(x => x.startsWith(`${sess}-`)).length > 1;
              const name = named ? groupNames[chunk] : sessName(sess) + (many ? ` ${chunk + 1}` : "");
              const last = named && idx === keys.length - 1;
              const meta = `${s.range.replace("{{a}}", String(g[0].n)).replace("{{b}}", String(g[g.length - 1].n))} · ${clock(g[0].open)}–${clock(g[g.length - 1].close)}`;
              const tiles = g
                .map(b => `<button type="button" class="ba-tile is-new" data-close="${b.close}" title="${s.ringAt.replace("{{t}}", at(b.alarm))}">
                  <span class="ba-n">${s.bar.replace("{{n}}", String(b.n))}</span><span class="ba-tag"></span>
                  <span class="ba-win">${clock(b.open)}–${clock(b.close)}</span>
                </button>`)
                .join("");
              return `<details class="ba-group" data-g="${k}">
                <summary><span class="ba-gname">${name}</span><span class="ba-gmeta">${meta}${last ? ` · ${s.lastHint}` : ""}</span><span class="ba-gcount"></span></summary>
                <div class="ba-tiles">${tiles}</div>
              </details>`;
            })
            .join("");
        }

        // 到了新的时段：只展开这一段，其他收起
        const g = groupOf(head);
        if (g !== activeGroup) {
          activeGroup = g;
          list.querySelectorAll<HTMLDetailsElement>(".ba-group").forEach(el => {
            el.open = el.dataset.g === g;
            el.classList.toggle("is-active", el.open);
          });
        }

        const byClose = new Map(bars.map(b => [b.close, b]));
        list.querySelectorAll<HTMLButtonElement>(".ba-tile").forEach(btn => {
          const b = byClose.get(+btn.dataset.close!)!;
          const past = b.alarm <= now;
          const off = !past && isSkipped(b);
          const cls = `ba-tile${past ? " is-past" : off ? " is-off" : ""}${b.open <= now && now < b.close ? " is-now" : ""}`;
          if (btn.className === cls) return;
          btn.className = cls;
          btn.disabled = past;
          btn.setAttribute("aria-pressed", String(!past && !off));
          btn.querySelector(".ba-tag")!.textContent = past ? "" : off ? s.off : s.on;
        });
        list.querySelectorAll<HTMLElement>(".ba-group").forEach(el => {
          const n = el.querySelectorAll(".ba-tile.is-off").length;
          const txt = n ? s.offCount.replace("{{n}}", String(n)) : "";
          const c = el.querySelector(".ba-gcount")!;
          if (c.textContent !== txt) c.textContent = txt;
        });

        const today = parts(tz, now);
        $(".ba-listday").textContent = head.day === `${today.mo}/${today.d}` ? s.upcoming : s.upcomingDay.replace("{{d}}", head.day);
      }

      function render() {
        const now = Date.now();
        // 提前量不是整分钟（比如 30 秒）时，提醒时间要带秒
        const at = (ms: number) => clock(ms, state.settings.lead % 60 !== 0);
        const bars = upcoming(state.settings, now - state.settings.tf * 60000, 13);
        const current = bars.find(b => b.open <= now && now < b.close);
        const future = bars.filter(b => b.alarm > now);
        const next = future.find(b => !isSkipped(b));

        $(".ba-clock").textContent = clock(now, true);
        const runBtn = $<HTMLButtonElement>(".ba-run");
        runBtn.textContent = running ? s.stop : s.start;
        runBtn.setAttribute("aria-pressed", String(running));
        root.classList.toggle("is-running", running);

        const fill = $<HTMLElement>(".ba-bar span");
        if (current) {
          const left = Math.ceil((current.close - now) / 1000);
          $(".ba-state").textContent = s.inBar
            .replace("{{bar}}", barName(current))
            .replace("{{left}}", `${Math.floor(left / 60)}:${pad(left % 60)}`);
          fill.style.width = `${((now - current.open) / (current.close - current.open)) * 100}%`;
        } else {
          $(".ba-state").textContent = s.outside;
          fill.style.width = "0";
        }
        $(".ba-next").textContent = !running
          ? s.stopped
          : ctx?.state !== "running"
            ? s.resumeHint
          : next
            ? s.nextAlarm
                .replace("{{t}}", at(next.alarm))
                .replace("{{bar}}", barName(next))
                .replace("{{in}}", fmtIn(next.alarm - now))
            : s.noAlarm;
        if (state.muteUntil > now)
          $(".ba-next").textContent += " · " + s.mutedUntil.replace("{{t}}", clock(state.muteUntil));

        // 列表显示的交易日：正在进行的那根所属的一天（凌晨的夜盘算前一天），否则是下一根所属的一天
        const head = current || upcoming(state.settings, now, 1)[0];
        if (head) renderDay(head, now, at);

        reschedule(next);
        // 系统通知跟着计时器走：上一次检查到现在之间到点的提醒都发（声音已经排在音频时钟上）
        if (running)
          bars.filter(b => b.alarm > lastTick && b.alarm <= now && !isSkipped(b)).forEach(notify);
        lastTick = now;
      }
      const fmtIn = (ms: number) => {
        const t = Math.max(0, Math.round(ms / 1000));
        return t >= 3600 ? `${Math.floor(t / 3600)}h${pad(Math.floor((t % 3600) / 60))}m` : `${Math.floor(t / 60)}:${pad(t % 60)}`;
      };

      // —— 操作 ——
      function skipNext(k: number) {
        const now = Date.now();
        const future = upcoming(state.settings, now, 40).filter(b => b.alarm > now && !isSkipped(b));
        future.slice(0, k).forEach(b => state.skipped.push(b.close));
        persist();
        render();
      }
      function restoreAll() {
        state.skipped = [];
        state.muteUntil = 0;
        persist();
        render();
      }
      async function toggleRun() {
        running = !running;
        state.running = running;
        persist();
        if (running) {
          ctx ??= new AudioContext();
          await ctx.resume();
        } else unschedule();
        render();
      }

      root.addEventListener("click", e => {
        const t = e.target as HTMLElement;
        if (t.closest(".ba-run")) return void toggleRun();
        const gear = t.closest<HTMLButtonElement>(".ba-gear");
        if (gear) {
          form.hidden = !form.hidden;
          gear.setAttribute("aria-expanded", String(!form.hidden));
          return;
        }
        const sk = t.closest<HTMLElement>("[data-skip]");
        if (sk) return skipNext(+sk.dataset.skip!);
        const mu = t.closest<HTMLElement>("[data-mute]");
        if (mu) {
          state.muteUntil = Date.now() + +mu.dataset.mute! * 60000;
          persist();
          return render();
        }
        if (t.closest("[data-restore]")) return restoreAll();
        const one = t.closest<HTMLElement>("[data-close]");
        if (one) {
          const c = +one.dataset.close!;
          state.skipped = state.skipped.includes(c) ? state.skipped.filter(x => x !== c) : [...state.skipped, c];
          persist();
          return render();
        }
        if (t.closest(".ba-test")) {
          ctx ??= new AudioContext();
          ctx.resume().then(() => beepAt(ctx!.currentTime + 0.05));
        }
      });

      form.addEventListener("change", async e => {
        const t = e.target as HTMLInputElement;
        state.settings = {
          ...state.settings,
          tf: +field("tf").value,
          lead: +field("lead").value,
          vol: +field("vol").value,
          notify: field("notify").checked,
        };
        // 改了时段才单独存这个市场的时段；清空的格子用默认值
        if (/^(from|to)\d$/.test(t.name))
          state.settings.sessions[state.settings.market] = MARKETS[state.settings.market].sessions.map(([a, b], i) => [
            field(`from${i}`).value || a,
            field(`to${i}`).value || b,
          ]);
        if (t.name === "notify" && t.checked && "Notification" in window && Notification.permission === "default")
          await Notification.requestPermission();
        unschedule(); // 音量、周期变了都要按新设置重排
        persist();
        render();
      });

      // 换市场：时区、交易时段、K 线列表都换成当地的；“不响”和静音是按时刻记的，换了市场就清掉
      marketSel.addEventListener("change", () => {
        state.settings.market = marketSel.value;
        state.skipped = [];
        state.muteUntil = 0;
        useMarket();
        unschedule();
        persist();
        render();
      });

      // 键盘：N 跳过下一根，R 全部恢复（输入框里不算）
      document.addEventListener("keydown", e => {
        if (!document.body.contains(root)) return;
        if ((e.target as HTMLElement).closest("input, select, textarea") || e.metaKey || e.ctrlKey || e.altKey) return;
        if (e.key === "n" || e.key === "N") skipNext(1);
        if (e.key === "r" || e.key === "R") restoreAll();
      });

      // 提醒开着但声音被挂起（刚刷新、手机切回来）：点页面任何地方、按任何键都恢复
      const wake = () => {
        if (document.body.contains(root) && running && ctx && ctx.state !== "running") ctx.resume();
      };
      document.addEventListener("pointerdown", wake);
      document.addEventListener("keydown", wake);

      render();
      const timer = window.setInterval(() => {
        if (!document.body.contains(root)) return window.clearInterval(timer);
        render();
      }, 250);
    });
  }

  document.addEventListener("astro:page-load", setup);
</script>
